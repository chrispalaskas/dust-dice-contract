// SPDX-License-Identifier: Apache-2.0
//
// ===========================================================================================
// Dust Dice -- the Table contract. One deployment per table.
// SIMULTANEOUS ROUNDS, INTERACTIVE HOLDS.
// ===========================================================================================
//
// Implements docs/simultaneous-rounds.md plus the interactive-hold amendment. Every seat plays
// each round independently and the round advances when they have all finished; within a round a
// player sees each roll, picks the dice to keep, and may stop and score at any point. A seat
// that stops responding is eliminated, forfeits a share of its stake that grows with how far the
// game has run, and redeems the rest once the table is over.
//
// This REPLACES two earlier designs at once. The seat cursor of docs/table-contract.md, under
// which five players waited while one played, is gone. So are the six pre-declared hold
// policies (Stand, RerollAll, KeepModal, KeepFace, ChaseStraight, KeepPairsPlus) and the
// witness-checked modal-face machinery they needed -- a hold is now five explicit bits the
// player sends after seeing the dice.
//
// NINE exported circuits -- join, playerMove, resolveRoll1, resolveReroll, closeRound,
// eliminate, settle, redeem, abortTable -- against a deploy ceiling MEASURED AT NINE on this
// node. See section 8: the old "11-12" figure was inherited, never tested, and is wrong.
//
// Two merges got the count there and both are load-bearing rather than tidiness. The
// interactive turn wants three player entry points where the old one wanted one (open a turn,
// hold, score); they are merged into a single `playerMove` with a kind discriminator. And rolls
// 2 and 3 are the same computation under different stored masks, so they are merged into
// `resolveReroll`, dispatched on the seat's own stage.
//
// Building blocks are `include`d verbatim and NOT reimplemented:
//   dice-core.compact     byte-threshold ladder, roll derivation      (measured)
//   scoring-core.compact  rawScore/applyScore/placeScore/totals,
//                         winner tie-break, witness-checked rake      (measured)
//   policy-core.compact   entropy scheme, the left-to-right reroll    (measured)
//
// -------------------------------------------------------------------------------------------
// 1. CONFLICT-FREEDOM IS THE CONSTRAINT THAT SHAPES EVERYTHING BELOW
// -------------------------------------------------------------------------------------------
//
// A transaction's proof commits to the ledger values its transcript READ. The node re-executes
// the transcript at inclusion time and rejects it if any read value has moved
// (`Transcript(Execution(ReadMismatch))`). Binding is per-READ, not per-write and not
// whole-state: this was measured, not assumed (docs/concurrency-probe.md, 96 attempts).
//
// Three consequences the probe pins down, and this file is built on all three:
//
//   * A `Map.lookup` binds EXACTLY as a scalar read does. Per-seat storage is necessary but
//     not sufficient -- a circuit that writes one seat but reads all six collides with all six.
//     The old `forfeitFlags()` did precisely that.
//   * Reading a shared value is free of conflict as long as it does not CHANGE during the
//     window in which several actors read it. `openRound`, `roundDigest` and `roundDeadline`
//     have exactly that property: they are written ONLY by `closeRound`, which by construction
//     runs when no seat has a move in flight.
//   * `Counter.increment` commutes (it compiles to a native `addi` and never reads the value
//     back). Nothing here needs one, but it is the escape hatch if a shared accumulator is
//     ever wanted on the player path.
//
// THE RULE. `playerMove` writes only its own seat's entries and read-modify-writes NO shared
// scalar. That now has to hold for FOUR transactions per turn rather than one, since an
// interactive turn is open, hold, hold, score -- so the property is exercised four times as
// often and matters four times as much. The audit, field by field, is in the "Ledger state"
// section below, and src/test/ledger-access.ts re-derives it mechanically from the COMPILED
// TRANSCRIPT on every test run.
//
// `stampTime()` IS GONE. It read-modify-wrote `lastActionAt` in seven of the eight old
// circuits and would have serialised every move on its own. The per-round `roundDeadline`,
// written once by `closeRound`, replaces it. Only `join` and `closeRound` now declare a `now`
// at all; every other circuit tests block time against a stored deadline with an exact kernel
// predicate, which reads nothing and declares nothing.
//
// ONE SILENT HAZARD the probe exposes: two transactions writing the SAME map key both land,
// last-write-wins, with no error. That is why a seat's entries are only ever written by a
// transaction that has proved knowledge of that seat's `sk_s` (`playerMove`, for all three
// kinds), or of the table seed (`resolveRoll*`), or that is permissionless but
// idempotent-by-assertion (`eliminate` checks `!eliminated`, `redeem` checks `amount > 0`).
//
// -------------------------------------------------------------------------------------------
// 2. THE DIGEST IS FROZEN PER ROUND, AND THAT IS A SECURITY REQUIREMENT, NOT A TIDINESS ONE
// -------------------------------------------------------------------------------------------
//
// Under the cursor model, resolves happened in fixed seat order, so a running `gameDigest` gave
// the operator no ordering discretion. Under simultaneous rounds, transactions land in whatever
// order the chain picks -- and if the digest kept folding results as they landed, the operator
// would choose that order for its own resolves, and the digest feeds every subsequent roll.
// That hands it exactly the influence over outcomes the commit-reveal scheme exists to deny it.
//
// So: every seat in round `r` derives its rolls from `roundDigest` as it stood when round `r`
// OPENED, and `closeRound` computes
//
//     roundDigest' = H("dust-dice:v1:round", roundDigest, r, seatCount, results in SEAT ORDER)
//
// once, at the boundary, from data that is complete and ordered by seat index rather than by
// landing time. No participant's dice depend on who submitted first.
//
// EVERY SEAT'S DICE STREAM IS STILL DISTINCT, and it is worth saying where that comes from
// because `RollContext` has no seat field. The separation is entirely in `playerEntropy`, which
// is `mixEntropy(H(sk_s, tableId, r), roundDigest)`. Two seats can only collide by sharing a
// secret, and `join` refuses a second seat for a `C_s` already registered.
//
// RESIDUAL, stated rather than hidden: the operator still chooses whether to call
// `eliminate(s)` on a stalled seat or to keep waiting for it, and the two produce different
// digests. That is a coarse, public, one-shot fork that costs it a player and requires the
// seat's deadline to have already passed -- it is not a re-roll. The cursor model had the
// identical lever in `claimTimeout`, so this is not a regression.
//
// -------------------------------------------------------------------------------------------
// 3. EVERY CIRCUIT HAS A k FLOOR AS WELL AS A CEILING
// -------------------------------------------------------------------------------------------
//
// Found the hard way in live play. `claimTimeout` (k=11) was rejected by the node 1,610 times
// with `OutsideTimeToDismiss`, measured at 7,455-7,463 bytes against a required 8,269. Nothing
// else ever failed -- `abortTable` at k=12 and everything above landed every time.
//
// RAISING THE LEDGER PADDING DOES NOT FIX IT. It was raised 2 KB -> 4 KB and the transaction
// grew by a few hundred bytes, not 2,048: `pad(n, "...")` is a short tag followed by zero fill
// and serialises to almost nothing. The byte that matters is the PROOF, and proof size scales
// with the circuit's PLONK domain. The admission floor is a proof-size floor and the only
// reliable lever is k.
//
// So every exported circuit here targets **k in [13, 15]**: at or above 13 to clear the floor
// with margin, at or under 15 because the proof server bundles `bls_midnight_2p9 .. 2p15` and
// has no route to `srs.midnight.network`. Measured values are in docs/table-circuit.md and are
// re-checked by `npm run k -w cli`.
//
// Two circuits needed deliberate ballast to clear the floor, and both were given work that is
// worth doing rather than a hash over nothing -- see `eliminate` and `redeem`.
//
// -------------------------------------------------------------------------------------------
// 4. THE OPERATOR'S MOVE IS STILL THREE TRANSACTIONS, AND STILL AT THE CEILING
// -------------------------------------------------------------------------------------------
//
// Three transactions, now from TWO circuits: `resolveRoll1` once and `resolveReroll` twice.
// Both sit at k=15 with zero headroom: the domain is set by the roll hash and its rejection
// ladder, not by the transcript. Measured before this file was rewritten -- the interactive
// shape is 811 / 870 / 870 instructions and all of them are still k=15, merge included.
//
// The interactive redesign paid for itself here twice over. `resolveRoll1` lost the modal-face
// check and the mask computation, which is where its 1,173 instructions went; rolls 2 and 3
// gained the ten conditional selects of the left-to-right stream merge and still came out
// under the old figures. Anything that grows this path from here makes the contract
// UNPROVABLE rather than slow, which is why `closeRound` is a separate circuit and why the
// resolve steps touch exactly one map.
//
// -------------------------------------------------------------------------------------------
// 8. THE DEPLOY HAS ITS OWN CEILING, AND IT IS NINE CIRCUITS -- NOT THE INHERITED 11-12
// -------------------------------------------------------------------------------------------
//
// Every previous revision of this file said "against a deploy ceiling measured at 11-12". That
// figure was inherited from a neighbouring project and had never been tested here. It is wrong,
// and the real limit is both lower and differently shaped.
//
// A deploy transaction carries ONE VERIFIER KEY PER EXPORTED CIRCUIT, and the node refuses the
// transaction outright when the total is too large:
//
//     1010: Invalid Transaction: Transaction would exhaust the block limits
//
// Measured on midnight-node 2.0.0-rc.4, by deploying real contracts and nothing else
// (`npm run deploy-probe -w cli`):
//
//     8 circuits, 15,416 verifier bytes   ->  deploys
//     9 circuits, 19,071 verifier bytes   ->  deploys
//    10 circuits, 21,190 verifier bytes   ->  REFUSED
//
// So the limit is between 19,071 and 21,190 bytes of verifier key, and it is BYTES rather than
// circuits: a verifier key is 1,351 bytes at k <= 12 and 2,119 bytes at k >= 13.
//
// THAT LAST FACT IS THE TRAP, and it is the direct opposite of section 3. Raising a small
// circuit's k to clear the node's proof-size ADMISSION floor also enlarges its verifier key and
// pushes the DEPLOY toward the block limit. The two limits pull in opposite directions:
//
//     k <= 12   small verifier key (1,351 B), deploy-friendly, RISKS OutsideTimeToDismiss
//     k >= 13   clears the admission floor,   verifier key 2,119 B, costs deploy budget
//
// The previous design could afford eight circuits partly BECAUSE two of them (`claimTimeout` at
// k=11 and `abortTable` at k=12) had small keys -- and `claimTimeout` at k=11 is exactly the
// circuit that then failed admission 1,610 times. There is no setting of k that is free.
//
// This contract resolves it by keeping every circuit at k >= 13 -- so nothing is ever refused at
// admission -- and paying for that with a hard cap of NINE exported circuits. That is why
// `playerMove` and `resolveReroll` are merged, and it is why adding a tenth circuit is not a
// judgement call: it does not deploy.
//
// -------------------------------------------------------------------------------------------
// 5. TIME IS DECLARED AND SANDWICHED, IN THE TWO CIRCUITS THAT STILL NEED IT
// -------------------------------------------------------------------------------------------
//
// The kernel exposes block-time PREDICATES only -- `blockTimeGt/Gte/Lt/Lte(Uint<64>)`, seconds
// since epoch, strict. There is no `blockTime()` accessor (probed against compactc 0.34.0). So
// a circuit that has to STAMP a deadline must be told the time and pin the claim:
//
//     blockTimeGte(now)                  =>  now <= blockTime
//     blockTimeLt(now + timeSlackSecs()) =>  now >  blockTime - timeSlackSecs()
//
// which traps `now` in `(blockTime - slack, blockTime]`. A caller can only under-declare, and
// by at most the slack.
//
// THE INCENTIVE DOES NOT POINT THE SAFE WAY. `closeRound` stamps the deadline that the NEXT
// round's players are judged against, and it is permissionless, so a hostile caller can shave
// up to `timeSlackSecs()` off everyone's window for free. That is docs/security-review.md's
// Critical C1 and it is closed the same way it was before: `timeSlackSecs()` is 120 rather than
// 600, and the constructor refuses any timeout that is not strictly greater than
// `timeSlackSecs() * timeoutSlackFactor()`, so the most a hostile declarer can take is a
// bounded fraction of the window -- half, at the floor, since the factor became 2 to admit
// five-minute rounds on fast tables (see `timeoutSlackFactor`).
//
// ONLY TWO CIRCUITS TAKE A `now`, and that is a deliberate reduction from seven. Nothing else
// has a deadline to stamp: `playerMove`, the three resolves, `eliminate`, `settle`, `redeem`
// and `abortTable` all compare real block time against a STORED deadline with a kernel
// predicate, so there is nothing to declare and nothing to under-declare. Giving them a `now`
// argument would cost public inputs and re-open C1's surface to buy nothing.
//
// -------------------------------------------------------------------------------------------
// 6. CUSTODY: balance == pot + SUM(redeemable), AND THE TWO NEVER MIX
// -------------------------------------------------------------------------------------------
//
//   * `pot` is money that goes to the winner (and the rake). `join` puts a stake in it.
//   * `seatRedeemable[s]` is money owed to seat `s` personally. Only `redeem` pays it out, and
//     only to the address seat `s` recorded at `join`.
//   * `eliminate` moves `tier - penalty` from `pot` to `seatRedeemable[s]`. The penalty stays
//     in the pot and goes to the winner.
//   * `settle` pays out exactly `pot` and touches no `redeemable`.
//   * `abortTable` moves the whole `pot` into `redeemable`, so nothing is left stranded.
//
// The invariant `pot + SUM(redeemable) == tier * seatCount` is asserted in-circuit by `settle`
// and by `abortTable`, which are the two circuits that zero the pot. It CANNOT be checked
// against the contract's real balance offline: `unshieldedBalance(nativeToken())` returns 0
// under @midnight-ntwrk/compact-runtime 0.19.0 no matter what `receiveUnshielded` was called
// with (docs/bugs-found.md #11), so the ledger-vs-bookkeeping cross-check lives in the E2E
// devnet run and nowhere else.
//
// -------------------------------------------------------------------------------------------
// 7. SEAT STORAGE IS FIVE LEDGER `Map`s KEYED BY SEAT INDEX, SPLIT BY WHO READS THEM
// -------------------------------------------------------------------------------------------
//
// A `Vector` index must be a compile-time constant, so every runtime seat access would be a
// 6-way disjunction to read and a 6-way rebuild to write. A ledger `Map` takes a runtime key.
// The split across five maps is chosen so that the three circuits with NO headroom
// (`resolveRoll1/2/3`) touch exactly one map, and so that `closeRound` -- which must read all
// six seats -- reads only one of the others:
//
//   seatIdentity    written once, at join           read by playerMove, settle, redeem
//   seatCard        written by playerMove(score)    read by playerMove, redeem
//   seatProgress    round cursor + score + dice     read by all six seats at closeRound/settle
//   seatTurn        the interactive turn state      read/written by playerMove and all resolves
//   seatRedeemable  money owed to a seat            eliminate, abortTable, redeem
//
// ALL SIX SLOTS ARE PRE-INSERTED BY THE CONSTRUCTOR, including slots no player will take. A
// ledger `Map.lookup` of an absent key aborts, so pre-inserting makes every lookup total.
// Whether a slot is real is `seat < seatCount`, never map membership.
//
// WHY `playerMove(score)` AND NOT `resolveRoll3` ADVANCES `seatProgress.round`: because a turn
// can now end after ANY roll, there is no single resolve step that means "this seat is done".
// Scoring is the only move that ends a turn, so scoring is what advances the cursor -- and it
// also sets `seatTurn.stage` back to idle, which is what lets `closeRound` decide "every seat
// has finished round r" from `seatProgress` alone without also reading six `seatTurn` entries.
//
// -------------------------------------------------------------------------------------------
// The randomness residual GREW with interactive holds, and the old wording no longer applies
// -------------------------------------------------------------------------------------------
//
// `entropy_s(r)` is forced to `H(sk_s, tableId, r)` and proven against a join-time commitment,
// so a player has no free choice there, and that part is unchanged.
//
// WHAT CHANGED. Under pre-declared policies, a player who knew the seed could preview the
// eleven legal policy choices for the coming turn and take the best -- bounded, and partly
// captured by any skilled honest player anyway. With interactive holds the same player can do
// strictly better: they see roll 1, they can compute roll 2 and roll 3 for EVERY one of the 32
// possible hold masks, and they can then choose the mask that maximises their final hand. They
// can do it again after roll 2. That is not best-of-11, it is an optimal decision under perfect
// information about the future, taken twice per turn, for thirteen turns.
//
// It is stated plainly here because the old "bounded, best-of-11" note would now be false. What
// has NOT changed is the precondition: it requires the seed, so it falls under the assumption
// the design already states and relies on elsewhere -- the operator must not seat itself at
// tables it operates, and must not leak the seed. Under that assumption the exposure is zero.
// If it is violated, interactive holds make the violation worth substantially more than
// pre-declared policies did, and the site's threat model should say so.
//
// No mitigation is attempted. Removing it means removing the choice, which is the whole
// feature.
//
// SIMULTANEITY ADDS ONE SMALLER THING, unchanged from the previous revision: within a round,
// seats submit in an order the chain picks, and each seat's rolls become public as they are
// resolved. A seat that has not yet chosen its hold can therefore see other seats' dice for the
// same round. That is NOT a randomness leak -- a seat's own dice depend only on the frozen round
// digest, its own forced entropy and the seed, so nothing another seat does can move them -- but
// it is an information asymmetry in the ordinary game-theory sense, like acting last at a poker
// table.

pragma language_version >= 0.26;

import CompactStandardLibrary;

include "dice-core";

include "scoring-core";

include "policy-core";

// ===========================================================================================
// Game shape
// ===========================================================================================

/**
 * Rounds per seat: 0..12 inclusive, thirteen in total, one category each.
 *
 * THIRTEEN AND NOT FOURTEEN, and the change is a direct consequence of interactive holds. The
 * cursor model PIPELINED the category: `takeTurn` at round r scored the dice resolved at round
 * r-1, because a circuit that both derived dice and scored them could not be compiled
 * (docs/bugs-found.md #1, fan-in x re-reads). That bought a fourteenth, score-only round and two
 * awkward sentinel cases at the ends.
 *
 * The interactive turn already splits derivation from scoring across transactions -- the dice
 * are written to the ledger by a resolve and read back as a leaf by `playerMove(score)` -- so
 * the pipeline is unnecessary. A seat scores the dice it just rolled, in the round it rolled
 * them, and there is no round without a category.
 *
 * `openRound == roundCount()` means the game is over and `settle` opens.
 */
pure circuit roundCount(): Uint<8> {
  return 13;
}

/** The last round a seat plays. Completing it completes the scorecard. */
pure circuit finalRound(): Uint<8> {
  return 12;
}

/**
 * The denominator of the elimination penalty: `stake * (r + 1) / penaltyDenom()`.
 *
 * Thirteen, because there are thirteen scoring rounds. Rounds are numbered 0..12 here and
 * 1..13 in docs/simultaneous-rounds.md, which is why the numerator is `r + 1`: a seat that quits
 * before playing anything forfeits a thirteenth, and one that quits in the final round forfeits
 * the lot. Nobody forfeits zero, which is the point -- never showing up must not be free.
 */
pure circuit penaltyDenom(): Uint<64> {
  return 13;
}

// -------------------------------------------------------------------------------------------
// The interactive turn, as a state machine
// -------------------------------------------------------------------------------------------
//
// `seatTurn.stage` for one seat within one round:
//
//     0  idle          the seat has not opened its turn, or has finished it
//     1  awaiting r1   playerMove(open) ran; the operator owes resolveRoll1
//     2  rolled once   the player may hold, or score and stop
//     3  awaiting r2   playerMove(hold) ran; the operator owes resolveRoll2
//     4  rolled twice  the player may hold again, or score and stop
//     5  awaiting r3   playerMove(hold) ran; the operator owes resolveRoll3
//     6  rolled thrice the player must score; there are no rolls left
//
// EVEN STAGES ARE OWED BY THE PLAYER AND ODD STAGES BY THE OPERATOR. That split is what
// `eliminate` and `abortTable` divide on, and it is the whole of the "whose fault is the stall"
// question: a player who never sends a hold is eliminable at 2 or 4 exactly as one who never
// opened a turn is eliminable at 0, and an operator that never resolves leaves the seat at 1, 3
// or 5 where `eliminate` refuses and `abortTable` is the remedy.

pure circuit stageIdle(): Uint<8> {
  return 0;
}

pure circuit stageAwaitRoll1(): Uint<8> {
  return 1;
}

pure circuit stageRolled1(): Uint<8> {
  return 2;
}

pure circuit stageAwaitRoll2(): Uint<8> {
  return 3;
}

pure circuit stageRolled2(): Uint<8> {
  return 4;
}

pure circuit stageAwaitRoll3(): Uint<8> {
  return 5;
}

pure circuit stageRolled3(): Uint<8> {
  return 6;
}

/** Is the PLAYER the one who owes the next move? See the state machine above. */
pure circuit playerOwes(stage: Uint<8>): Boolean {
  return stage == stageIdle() ||
         stage == stageRolled1() ||
         stage == stageRolled2() ||
         stage == stageRolled3();
}

// -------------------------------------------------------------------------------------------
// `playerMove` kinds
// -------------------------------------------------------------------------------------------
//
// A `Uint<8>` and not a Compact `enum`, matching the category and (former) policy encodings:
// the value is compared arithmetically and it appears in the client's argument encoding, where
// a plain number is what the daemon and the website actually send.

/** Open this round's turn: prove the secret, declare the forced entropy, await roll 1. */
pure circuit moveOpen(): Uint<8> {
  return 0;
}

/** Keep these five dice and roll again. */
pure circuit moveHold(): Uint<8> {
  return 1;
}

/** Score the dice as they stand and end the turn. Legal after any resolved roll. */
pure circuit moveScore(): Uint<8> {
  return 2;
}

/** One past the last valid kind. */
pure circuit moveKindCount(): Uint<8> {
  return 3;
}

/**
 * Slack allowed on a declared `now`, in seconds. See section 5 of the header.
 *
 * 120 s, and deliberately small: the slack is a weapon in the hands of whoever declares it, so
 * it is sized to what it actually has to absorb -- proving plus submission, measured at ~21 s --
 * plus room for clock skew. Only `join` and `closeRound` declare a time at all.
 */
pure circuit timeSlackSecs(): Uint<64> {
  return 120;
}

/**
 * The multiple of `timeSlackSecs()` that every timeout parameter must strictly exceed.
 *
 * Two (was four): the floor is 240 s, so a fast table may run FIVE-MINUTE rounds -- a fast turn
 * takes ~35 s, so five minutes is generous -- and a caller who under-declares by the full slack
 * can consume at most 120 s of a 300 s window, leaving the players well over half of it. The
 * slack itself stays 120 s rather than shrinking, because it also has to absorb a wallet's
 * approval prompt between reading the chain time and the transaction landing; a tighter slack
 * would turn a slow click into a rejected join. On-chain tables keep their 600/900 s rounds and
 * are untouched by the floor.
 */
pure circuit timeoutSlackFactor(): Uint<64> {
  return 2;
}

/** Rake denominator. 1% -- `scoring-core.compact`'s `rakeIsValid` hard-codes the 100. */
pure circuit minTier(): Uint<64> {
  return 100;
}

/**
 * Largest stake a table may be opened with, in the smallest NIGHT unit: 10^15.
 *
 * Two products have to stay inside `Uint<64>`: `tier * seatCount` (the custody invariant, and
 * `abortTable`'s refund total) and `tier * penaltyDenom()` (the elimination penalty identity).
 * At the bound those are 6e15 and 1.3e16, both far under `Uint<64>`'s 1.8e19. An overflow in
 * either would abort a REFUND path while leaving `settle` working -- i.e. the pot could only
 * ever leave through the winner -- so the bound is a safety property, not tuning.
 */
pure circuit maxTier(): Uint<64> {
  return 1000000000000000;
}

export enum Phase {
  /** Seats still open; `join` is the only legal move. */
  filling,
  /** Full table, game running. */
  playing,
  /** `settle` paid the winner and the rake. Terminal; `redeem` opens. */
  settled,
  /** `abortTable` converted the pot into per-seat refunds. Terminal; `redeem` opens. */
  aborted,
  /**
   * Every seat was eliminated, so there is no one left to play and no one who earned the pot.
   * Reachable only from `eliminate`.
   *
   * NOT yet redeemable. It is a PENDING terminal state: the all-eliminated waiver (penalties
   * refunded, rake still paid) is applied by a single permissionless `abortTable` call, which
   * moves the table to `aborted`. See `abortTable` for why the waiver lives there and not in
   * `eliminate`.
   */
  abandoned,
}

// ===========================================================================================
// Ledger state
// ===========================================================================================
//
// CONCURRENCY AUDIT OF THE PLAYER PATH. `playerMove` reads, and therefore binds to:
//
//   phase           frozen for the whole game once `playing`
//   openRound       written ONLY by closeRound, which cannot run while a seat may still move
//   seatCount       written only by join, and join only runs while `filling`
//   tableId         sealed
//   seatIdentity[s] written once, at join
//   seatCard[s]     this seat's own
//   seatProgress[s] this seat's own
//   seatTurn[s]     this seat's own
//
// and writes seatCard[s], seatProgress[s], seatTurn[s] -- all blind `insert`s on its own key.
// No shared scalar is read-modify-written anywhere on that path. `pot`, `activeSeats`,
// `roundDigest` and `roundDeadline` are not touched by `playerMove` at all.
//
// `eliminate` DOES read-modify-write `pot` and `activeSeats`, and two concurrent eliminations
// therefore conflict and one is rejected. That is correct and deliberate: they are the only
// two shared accumulators in the contract and both are off the player's path. The loser
// retries. It also binds to the victim's own `seatProgress` and `seatTurn`, which is what
// makes `eliminate(s)` racing seat `s`'s own `playerMove` resolve to exactly one winner
// instead of silently applying both.

/**
 * `tableId` is a constructor argument and NOT `kernel.self()`: `kernel.self()` returns zeros
 * in a constructor (inherited defect #13, docs/bugs-found.md §0). It must be fresh random per
 * table -- it is a domain separator on every roll hash, so a reused id replays another table's
 * dice.
 */
export sealed ledger tableId: Bytes<32>;

/** Stake per seat, in the smallest NIGHT unit. The pot starts at exactly `tier * seatCount`. */
export sealed ledger tier: Uint<64>;

/** Seats this table opens with. 2..6. `join` flips to `playing` when the last one is taken. */
export sealed ledger seatLimit: Uint<8>;

/** Where the rake goes. Fixed at construction so `settle` needs no argument for it. */
export sealed ledger rakeAddress: UserAddress;

/**
 * `H(tableId, seed)`, committed before any player existed.
 *
 * Checked by all three `resolveRoll` steps and -- before the table deadline -- by `settle`.
 */
export sealed ledger seedCommitment: Bytes<32>;

/**
 * How long a whole round gets, in seconds. Past it, seats that owe a move can be eliminated.
 *
 * A ROUND, not a move. An interactive turn is up to four player transactions and three operator
 * ones, and they all share this one deadline -- so it has to be sized for the whole turn plus
 * the operator's round trips, not for one click. The operator SLA has to be written against
 * that, and a client should show the player the round deadline rather than a per-move one.
 */
export sealed ledger turnTimeoutSecs: Uint<64>;

/**
 * The operator's grace, and the fill deadline, in seconds.
 *
 * Used in three places: the time a filling table has to fill after each join; the extra grace
 * past `roundDeadline` before a table with a roll stuck mid-pipeline may be aborted; and the
 * grace past `roundDeadline` after which `settle` no longer requires the seed.
 */
export sealed ledger tableTimeoutSecs: Uint<64>;

/**
 * The table's play mode, fixed at deploy and consented to by joining (docs/fast-turn-design.md).
 *
 * `false` — every roll on-chain: holds and resolves are individual transactions, so the
 * no-lookahead ORDERING (each hold committed before the next roll was revealed) is proven to
 * anyone by block order.
 *
 * `true` — the fast table: the turn's interaction happens off-chain against the operator (who
 * reveals each roll only after holding the player's signed, pre-proven move) and lands as ONE
 * composed settlement transaction of these same circuits. The dice remain exactly as verifiable
 * (they are deterministic in the revealed seed); what becomes operator-ATTESTED rather than
 * chain-proven is the ordering. Between transactions a fast seat only ever rests at stage 0 or
 * stage 1 — the intermediate stages exist solely inside the settlement — which is why no
 * circuit needs to police the interactive path shut: there is no on-chain state for a defecting
 * hold to bind to, provided the operator never resolves a fast seat outside a settlement (its
 * published policy; an operator that breaks it is the colluding operator the threat model
 * already excludes, since it holds the seed).
 *
 * The one circuit that reads this is `eliminate`: on a fast table the stage-parity rule is
 * waived, because "odd stage = the operator's silence" is only meaningful when resolves are
 * on-chain obligations.
 */
export sealed ledger fastMode: Boolean;

export ledger phase: Phase;

/** Seats taken so far. Also the next seat index while `filling`. */
export ledger seatCount: Uint<8>;

/** Seats not yet eliminated. At 0 the table is `abandoned`. */
export ledger activeSeats: Uint<8>;

/**
 * The round every seat is currently playing. 0..12 while playing; `roundCount()` means the game
 * is finished and `settle` is open.
 *
 * WRITTEN ONLY BY `closeRound`. That is the whole of the concurrency design: it is a shared
 * scalar that six simultaneous turns all read, and reading it is free precisely because it
 * cannot move while any of them is in flight.
 */
export ledger openRound: Uint<8>;

/**
 * The entropy every seat in the OPEN round derives its rolls from. Frozen at round open.
 *
 * `genesisDigest(tableId)` at construction, folded by each `join`, and then advanced exactly
 * once per round by `closeRound`. See section 2 of the header for why it must not advance
 * per-resolve.
 */
export ledger roundDigest: Bytes<32>;

/**
 * Block-time seconds by which the open round must be finished.
 *
 * Written by `closeRound` (round open + `turnTimeoutSecs`) and, while `filling`, by `join`
 * (join time + `tableTimeoutSecs`), which is what gives a table that never fills a deadline
 * without a second field. Every other deadline in the contract is derived from it:
 *
 *   eliminate       blockTimeGt(roundDeadline)
 *   abortTable      blockTimeGt(roundDeadline + tableTimeoutSecs)   [operator stalled]
 *   abortTable      blockTimeGt(roundDeadline)                      [never filled]
 *   settle waiver   blockTimeGt(roundDeadline + tableTimeoutSecs)
 *
 * It is a blind write in both writers -- neither reads the previous value -- which is what lets
 * it replace `lastActionAt` without reintroducing a binding read. The monotonicity check that
 * `stampTime` used to carry is gone with it, and does not need replacing: the sandwich already
 * traps a declared `now` within `timeSlackSecs()` of real block time.
 */
export ledger roundDeadline: Uint<64>;

/** Native NIGHT owed to the eventual winner. See section 6 of the header. */
export ledger pot: Uint<64>;

/**
 * The seed, once `settle` has revealed it. Zeros before -- and zeros forever on a force-settle.
 *
 * A non-zero value is the game's certificate of verifiability: it opens `seedCommitment`, so
 * anyone can replay every roll from the public log. `revealedSeed == 0` on a settled table is a
 * meaningful state ("paid but unverifiable"), not a "not settled yet" state.
 */
export ledger revealedSeed: Bytes<32>;

/** Winning seat, once settled. Meaningless before. */
export ledger winnerSeatIndex: Uint<8>;

/**
 * How this table ended, as one hash. Zeros until `settle` or `abortTable` runs.
 *
 * A closing certificate: it binds the final round digest, the phase the table ended in, the
 * winner, the amounts paid and whether the seed was actually revealed, in one value a client can
 * check without replaying the whole log or trusting the indexer's event ordering. It is also
 * `abortTable`'s k ballast -- see section 3 of the header and the doc comment on `abortTable`.
 */
export ledger finalDigest: Bytes<32>;

/** The five hold bits. A struct because a ledger cell holds one named type. */
export struct HoldMask {
  bits: Vector<5, Boolean>,
}

/** Written once per seat, at `join`. */
export struct SeatIdentity {
  /** Where this seat is paid. Recorded at join, so no circuit ever learns its caller. */
  addr: UserAddress,
  /** `C_s = H(tableId, sk_s)`. Every `playerMove` proves knowledge of `sk_s` against it. */
  keyCommit: Bytes<32>,
}

/**
 * A seat's position in the game: which round it owes, what it has scored, its last dice.
 *
 * This is the map `closeRound` reads all six of, so it is kept as small as the job allows --
 * the turn state lives in `seatTurn` and the money in `seatRedeemable`.
 */
/**
 * `finishedAtRound` sentinel for a seat that LEFT A FILLING TABLE before it started. Distinct
 * from `noFinish()` (eliminated during play) because the two are treated differently ever
 * after: a pre-start leaver was refunded in full and may `redeem` at once, and every later
 * share-out (`abortTable`) skips it; a mid-game elimination waits for a terminal phase and is
 * covered by the all-eliminated waiver.
 */
pure circuit leftBeforeStart(): Uint<16> {
  return 65534;
}

export struct SeatProgress {
  /**
   * The next round this seat owes. `roundCount()` means finished (or eliminated).
   *
   * Advanced by `playerMove(score)`, which is the only move that ends a turn. Because a turn
   * can now stop after any roll, no single resolve step means "this seat is done" -- so
   * `round > openRound` is by itself proof that the seat's whole move for the open round is
   * complete, and `closeRound` needs to read nothing else.
   */
  round: Uint<8>,
  /** Grand total including the upper bonus and five-of-a-kind bonuses, maintained incrementally. */
  total: Uint<16>,
  /**
   * The round at which the 13th category was taken; `noFinish()` if never.
   *
   * Under simultaneous rounds every surviving seat completes at `finalRound()`, so this
   * degenerates as a tie-break clock: what it actually distinguishes is "completed the card"
   * from "eliminated". Kept in the `Uint<16>` shape `winnerOfSeats` expects rather than
   * replaced, because the tie-break order it feeds is still exactly the reference's -- highest
   * total, then a completer over a non-completer, then the lowest seat index.
   */
  finishedAtRound: Uint<16>,
  /** Out of the game. Keeps its card for the record; cannot win; has a `seatRedeemable`. */
  eliminated: Boolean,
  /**
   * The dice this seat scored in its most recent completed turn. What the round digest folds.
   *
   * Initialised to all-ones, NOT all-zeros. `applyScore` reads `d[0]` as the Five of a Kind face and
   * computes `face - 1`, which underflows and aborts the circuit on a zero die. A circuit has
   * no branches, so the expression is evaluated even on a move that is not scoring -- the
   * placeholder has to be in range.
   */
  dice: Dice,
}

/**
 * One seat's interactive turn. The ONLY map the three resolve circuits touch.
 *
 * Under the cursor model these were seven shared singletons (`pendingEntropy`, `pendingPolicy`,
 * `pendingParam`, `rollStep`, `pendingMixed`, `pendingHold`, `pendingRoll`) and every resolve
 * read all of them. Keyed by seat, they are six independent pipelines that never intersect --
 * and `pendingPolicy` / `pendingParam` are gone entirely, because a hold is no longer a rule to
 * be evaluated later but five bits the player already chose.
 */
export struct SeatTurn {
  /** 0..6. See the state-machine comment above `stageIdle`. */
  stage: Uint<8>,
  /** The round this turn belongs to. Asserted equal to `openRound` by `resolveRoll1`. */
  round: Uint<8>,
  /** `H(sk_s, tableId, round)`, proven against the seat's join-time commitment when opened. */
  entropy: Bytes<32>,
  /**
   * `mixEntropy(entropy, roundDigest)`, latched by `resolveRoll1`.
   *
   * Carried in the ledger rather than recomputed by steps 2 and 3 because recomputing it is a
   * `persistentHash` per step and the whole point of the split is to fit under k=15. Not a new
   * disclosure: both its inputs were already public.
   */
  mixed: Bytes<32>,
  /**
   * The dice the player asked to keep before roll 2. Read by `resolveRoll2`, and by nothing
   * else.
   *
   * The PLAYER's choice, so the operator has no say in it whatever.
   */
  hold1: HoldMask,
  /**
   * The dice the player asked to keep before roll 3. Read by `resolveRoll3`, and by nothing
   * else.
   *
   * TWO CELLS AND NOT ONE OVERWRITTEN CELL, deliberately, and the reason is a planned future
   * version rather than anything this one needs. A shape under consideration moves the
   * interactive phase OFF chain and collapses the player's four transactions into two: an open,
   * and a single `finishTurn(mask1, mask2, category)` submitted after the player has explored
   * the rolls locally. That version needs both masks present before either reroll runs. Keeping
   * them in separate cells means it replaces exactly one circuit -- the player's -- and touches
   * neither resolve, neither deadline, nor any of the custody logic. One extra five-bit field
   * is a cheap price for a seam that narrow.
   */
  hold2: HoldMask,
  /**
   * The dice as of the most recent resolved roll.
   *
   * Public, and deliberately so: every roll lands on chain as its own transaction, which is
   * what makes an interactive hold possible at all -- the player has to see the dice to choose.
   */
  roll: Dice,
}

export ledger seatIdentity: Map<Uint<8>, SeatIdentity>;

export ledger seatCard: Map<Uint<8>, Scorecard>;

export ledger seatProgress: Map<Uint<8>, SeatProgress>;

export ledger seatTurn: Map<Uint<8>, SeatTurn>;

/**
 * Native NIGHT owed to a seat personally, and payable only to that seat's join-time address.
 *
 * Written by `eliminate` (the un-forfeited part of a stake) and by `abortTable` (the whole
 * refund); drained one seat at a time by `redeem`. Kept strictly separate from `pot` so that an
 * eliminated player's money can never be awarded to the winner by accident -- that separation
 * is the whole of the custody design.
 */
export ledger seatRedeemable: Map<Uint<8>, Uint<64>>;

/**
 * A per-seat hash chain of the two things that can happen to a seat's money.
 *
 * `eliminate` folds in the penalty arithmetic it performed; `redeem` folds in the payout and
 * the final scorecard it was paid against. Because `redeem` chains the previous value, a seat's
 * final receipt attests to its elimination too, so one 32-byte cell per seat carries the whole
 * custody story for that seat.
 *
 * Also the k ballast for both of those circuits: see section 3 of the header. Real work that
 * happens to be the right size, rather than a hash over nothing.
 */
export ledger seatReceipt: Map<Uint<8>, Bytes<32>>;

/**
 * Every `C_s` registered so far, so one secret cannot take two seats.
 *
 * NOT Sybil resistance: a player can generate a second `sk` and take a second seat, and no
 * circuit can tell. It rules out the accidental double-join, and it makes the seat-to-secret map
 * injective -- which the entropy scheme relies on, because a seat's dice stream is separated
 * from every other seat's ONLY by its secret.
 */
export ledger joinedKeys: Set<Bytes<32>>;

/** Sink for the transaction padding, so the compiler cannot drop it. See section 3. */
export ledger padStore: Bytes<4096>;

// -------------------------------------------------------------------------------------------
// Fields added after `padStore` on purpose: the test-side ledger parser anchors on the ADT
// block's addresses, and appending keeps every earlier address where it was.
// -------------------------------------------------------------------------------------------

/**
 * How long after the LAST join a filling table may start with fewer players than `seatLimit`
 * (but at least two). Zero disables early starts. Consented to by joining: the join panel
 * states it before the stake.
 */
export sealed ledger startAfterSecs: Uint<64>;

/**
 * True once the game has started -- by filling every seat, or by `abortTable`'s early start.
 * `abortTable` reads it to tell a table that was abandoned by everyone BEFORE it started (every
 * stake already refunded in full; nothing to waive, no rake) from one abandoned mid-game (the
 * penalty waiver, rake still paid).
 */
export ledger started: Boolean;

/**
 * What `redeem` has already paid each slot. The custody invariant is
 * `pot + SUM(seatRedeemable) + SUM(seatPaid) == tier * seatCount` for the life of the table;
 * without this term no seat could be paid before the table is terminal, and a player who leaves
 * a filling table should not wait for a game they are not in. PER SEAT and not one accumulator
 * on purpose: a shared scalar would make six redeems conflict, and `redeem` is conflict-free
 * (contract/src/test/table.test.ts pins it). Pre-inserted 0..5 like `seatRedeemable`.
 */
export ledger seatPaid: Map<Uint<8>, Uint<64>>;

/** Declared time of the most recent join -- the early-start clock's origin. */
export ledger fillOpenedAt: Uint<64>;

/**
 * A PRIVATE table's sealed invite commitment, `inviteCommitment(code)`; all zeros on a public
 * table. `join` proves knowledge of the code in zero knowledge -- the code itself never appears
 * on chain, and the operator that deployed the table only ever saw this hash.
 */
export sealed ledger inviteHash: Bytes<32>;

/**
 * The 4 KB of transaction padding, as a COMPILE-TIME CONSTANT.
 *
 * The width appears twice -- here and in `padStore`'s type -- and language 0.26 has no way to
 * write it once, because `pad`'s length argument must be a literal. A mismatch is a compile
 * error, not a silent shrink.
 *
 * A CONSTANT AND NOT AN ARGUMENT, and that is load-bearing: an exported circuit's parameters
 * are public inputs, measured at two public inputs and five instructions per 32-byte word
 * (docs/bugs-found.md #14), which was enough on its own to push the resolve circuits to k=16
 * and the contract out of provability. A constant is folded into the ledger op as a literal
 * `StateValue` push and is never an input at all.
 *
 * It does NOT clear the admission floor by itself -- see section 3 of the header. It is kept
 * because the transcript bytes are free and cannot hurt, not because it works.
 */
pure circuit paddingConstant(): Bytes<4096> {
  return pad(4096, "dust-dice:v1:pad");
}

// ===========================================================================================
// Witnesses
// ===========================================================================================
//
// TWO, where there were three. `modalFaceHint` is gone with the pre-declared policies: it
// existed only so that `KeepModal`'s mask could be witnessed-and-checked rather than computed,
// and there is no mask to compute any more.

/**
 * The player's entropy secret for this seat.
 *
 * `join` commits to it; every `playerMove` proves knowledge of it. This is the whole of a
 * player's authorisation -- authorisation here is structural, not address-based, so no circuit
 * ever needs to learn its caller (which it could not anyway: docs/gate0-report.md).
 */
witness playerEntropySecret(): Bytes<32>;

/**
 * The invite code for a private table, from the joiner's private state. Zeros for a public
 * table (the check is skipped when `inviteHash` is zero) and for every call but `join`.
 */
witness inviteCode(): Bytes<32>;

/**
 * The operator's roll seed, held off-chain until settlement.
 *
 * Knowledge of it IS the resolve circuits' authority: each checks it against the committed
 * `H(tableId, seed)`, and only the operator can produce a preimage. The seed is never disclosed
 * mid-game -- a resolve reveals only the resulting dice.
 */
witness rollSeed(): Bytes<32>;

// ===========================================================================================
// Domain-separated event hashing
// ===========================================================================================

/** The digest a fresh table starts from. Binds the chain of events to this table. */
pure circuit genesisDigest(id: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "dust-dice:v1:genesis"), id]);
}

/** One `join`, as hashed into `roundDigest`. Fixed-width fields, one hash, no concatenation. */
export struct JoinEvent {
  domain: Bytes<32>,
  prev: Bytes<32>,
  seat: Uint<8>,
  addr: UserAddress,
  keyCommit: Bytes<32>,
}

pure circuit joinDigest(
               prev: Bytes<32>,
               seat: Uint<8>,
               addr: UserAddress,
               keyCommit: Bytes<32>,
               ): Bytes<32> {
  return persistentHash<JoinEvent>(
           JoinEvent { domain: pad(32, "dust-dice:v1:join"),
                       prev: prev,
                       seat: seat,
                       addr: addr,
                       keyCommit: keyCommit, }
           );
}

/** One seat's contribution to a round's result: the dice it scored, and whether it is out. */
export struct RoundResult {
  dice: Dice,
  out: Boolean,
}

/**
 * A whole round, as hashed into `roundDigest` by `closeRound`.
 *
 * SEAT ORDER, not landing order. That is the entire point (section 2 of the header): the six
 * results are read out of `seatProgress` by index at the round boundary, so the operator's
 * choice of which seat to resolve first cannot change the digest and therefore cannot change
 * anybody's future dice.
 *
 * Slots at or above `seatCount` carry their constructor defaults and contribute a fixed value;
 * `seatCount` is hashed too, so a 2-seat table and a 6-seat table whose last four slots happen
 * to hold defaults are still distinguishable.
 */
export struct RoundEvent {
  domain: Bytes<32>,
  prev: Bytes<32>,
  round: Uint<8>,
  seatCount: Uint<8>,
  results: Vector<6, RoundResult>,
}

pure circuit roundDigestOf(
               prev: Bytes<32>,
               r: Uint<8>,
               seats: Uint<8>,
               results: Vector<6, RoundResult>,
               ): Bytes<32> {
  return persistentHash<RoundEvent>(
           RoundEvent { domain: pad(32, "dust-dice:v1:round"),
                        prev: prev,
                        round: r,
                        seatCount: seats,
                        results: results, }
           );
}

/**
 * The receipt `eliminate` writes into `seatReceipt`. Records the penalty arithmetic in full.
 *
 * Every term of the split is in the preimage -- the round charged, the stake, the forfeited
 * share and the refundable share -- so the receipt is checkable against the rule rather than
 * merely being a marker that something happened.
 */
export struct EliminateEvent {
  domain: Bytes<32>,
  prev: Bytes<32>,
  tableId: Bytes<32>,
  seat: Uint<8>,
  round: Uint<8>,
  tier: Uint<64>,
  penalty: Uint<64>,
  refund: Uint<64>,
}

pure circuit eliminateDigest(
               prev: Bytes<32>,
               id: Bytes<32>,
               seat: Uint<8>,
               r: Uint<8>,
               stake: Uint<64>,
               penalty: Uint<64>,
               refund: Uint<64>,
               ): Bytes<32> {
  return persistentHash<EliminateEvent>(
           EliminateEvent { domain: pad(32, "dust-dice:v1:eliminated"),
                            prev: prev,
                            tableId: id,
                            seat: seat,
                            round: r,
                            tier: stake,
                            penalty: penalty,
                            refund: refund, }
           );
}

/**
 * The receipt `redeem` writes. Binds the amount to the payee and to the card it was paid on.
 *
 * The scorecard is in the preimage for two reasons: it makes the receipt a statement about the
 * whole game rather than only about a number, and hashing it is real cryptographic work on a
 * circuit that is otherwise far too small to clear the admission floor. See `redeem`.
 *
 * `prev` chains the seat's earlier receipt, so a redeemed eliminated seat's final value attests
 * to the penalty it paid as well as to the sum it got back.
 */
export struct RedeemEvent {
  domain: Bytes<32>,
  prev: Bytes<32>,
  tableId: Bytes<32>,
  seat: Uint<8>,
  amount: Uint<64>,
  addr: UserAddress,
  card: Scorecard,
}

pure circuit redeemDigest(
               prev: Bytes<32>,
               id: Bytes<32>,
               seat: Uint<8>,
               amount: Uint<64>,
               addr: UserAddress,
               card: Scorecard,
               ): Bytes<32> {
  return persistentHash<RedeemEvent>(
           RedeemEvent { domain: pad(32, "dust-dice:v1:redeemed"),
                         prev: prev,
                         tableId: id,
                         seat: seat,
                         amount: amount,
                         addr: addr,
                         card: card, }
           );
}

/**
 * The closing certificate written to `finalDigest` by `settle` and by `abortTable`.
 *
 * One value that says how a table ended: which phase it landed in, which seat won (or
 * `maxSeats()` for an abort, which is not a seat), what the pot paid, what the rake took, what
 * each seat may redeem, and whether the seed was actually revealed. `prev` is the final round
 * digest, so the certificate is bound to the whole game that produced it.
 */
export struct FinalEvent {
  domain: Bytes<32>,
  prev: Bytes<32>,
  tableId: Bytes<32>,
  ending: Uint<8>,
  winner: Uint<8>,
  seatCount: Uint<8>,
  paid: Uint<64>,
  rake: Uint<64>,
  perSeat: Uint<64>,
  verifiable: Boolean,
}

pure circuit finalDigestOf(
               prev: Bytes<32>,
               id: Bytes<32>,
               ending: Uint<8>,
               winner: Uint<8>,
               seats: Uint<8>,
               paid: Uint<64>,
               rake: Uint<64>,
               perSeat: Uint<64>,
               verifiable: Boolean,
               ): Bytes<32> {
  return persistentHash<FinalEvent>(
           FinalEvent { domain: pad(32, "dust-dice:v1:final"),
                        prev: prev,
                        tableId: id,
                        ending: ending,
                        winner: winner,
                        seatCount: seats,
                        paid: paid,
                        rake: rake,
                        perSeat: perSeat,
                        verifiable: verifiable, }
           );
}

// ===========================================================================================
// Shared helpers
// ===========================================================================================

/**
 * Grow the transaction past the node's ~8 KB admission floor without growing its dismiss cost.
 *
 * MUST be the last thing every exported circuit does. `kernel.checkpoint()` closes the
 * guaranteed phase, so the write that follows lands in the fallible phase: it counts toward
 * the transaction's `est_size()` -- which is what earns the dismiss-time allowance -- but its
 * gas lands in `f_cost`, which `time_to_dismiss` never sums. A plain ledger write and NOT a
 * hash: hashing 4 KB pushes the circuit to k=17 and the proof server has no SRS for it.
 *
 * On its own this is NOT sufficient (section 3 of the header): the byte that decides admission
 * is the proof, and proof size follows k. Keeping every circuit at k >= 13 is the real fix and
 * this is the belt to its braces.
 */
circuit padTransaction(): [] {
  kernel.checkpoint();
  padStore = paddingConstant();
}

/**
 * Pin a declared `now` to real block time. See section 5 of the header.
 *
 * `now` must already be `disclose`d by the caller: it arrives as an exported circuit's
 * parameter, which is a private input to the proof exactly like a witness result, so the kernel
 * predicates need it declared public.
 *
 * Deliberately does NOT write anything, and deliberately has no monotonicity check. Both would
 * need a shared scalar read, which is what the whole redesign exists to remove.
 */
circuit pinTime(now: Uint<64>): [] {
  assert(blockTimeGte(now), "declared time is ahead of block time");
  assert(blockTimeLt((now + timeSlackSecs()) as Uint<64>),
         "declared time is further behind block time than the allowed slack"
         );
}

/**
 * `SUM(seatRedeemable)` over all six slots.
 *
 * Six `Map.lookup`s, so it BINDS to all six -- only ever called from `settle` and `abortTable`,
 * which are terminal and serialised by construction (each asserts a phase it then leaves).
 */
/** Everything `redeem` has paid out so far, over the six slots. */
circuit totalPaid(): Uint<64> {
  return (seatPaid.lookup(0) +
          seatPaid.lookup(1) +
          seatPaid.lookup(2) +
          seatPaid.lookup(3) +
          seatPaid.lookup(4) +
          seatPaid.lookup(5))
         as Uint<64>;
}

circuit totalRedeemable(): Uint<64> {
  return (seatRedeemable.lookup(0) +
          seatRedeemable.lookup(1) +
          seatRedeemable.lookup(2) +
          seatRedeemable.lookup(3) +
          seatRedeemable.lookup(4) +
          seatRedeemable.lookup(5))
         as Uint<64>;
}

/**
 * The custody invariant, in-circuit: every atom the contract ever received is still accounted
 * for, either as pot or as somebody's redeemable.
 *
 * Asserted by the two circuits that zero the pot. It is bookkeeping against bookkeeping, not
 * against the chain -- `unshieldedBalance` is inert under the simulator AND is the wrong thing
 * to read anyway (docs/bugs-found.md #11) -- so the ledger-vs-contract half of the check lives
 * in the E2E devnet run. What this catches is an arithmetic slip inside the contract, which is
 * the failure mode a test can actually reach.
 */
circuit assertCustody(): [] {
  assert((pot + totalRedeemable() + totalPaid()) == (tier * (seatCount as Uint<64>)),
         "custody invariant broken: pot + redeemable + paid != tier * seatCount"
         );
}

// ===========================================================================================
// Constructor
// ===========================================================================================

/**
 * Open an empty table.
 *
 * Called by the operator, which has already generated `seed`, persisted it to disk keyed by
 * the table address, and computed `seedCommitmentOf(id, seed)` -- the commitment is made BEFORE
 * any player exists, which is what makes the commit-reveal sound.
 *
 * `roundDeadline` stays 0, so an EMPTY table is never abortable: `abortTable`'s filling case
 * requires `seatCount > 0`, and the first `join` is what starts the fill clock. Aborting a
 * freshly opened table on sight would be a free griefing move against a table with no funds.
 */
constructor(id: Bytes<32>,
            stake: Uint<64>,
            seats: Uint<8>,
            rakeTo: UserAddress,
            seedCommit: Bytes<32>,
            turnTimeout: Uint<64>,
            tableTimeout: Uint<64>,
            fast: Boolean,
            startAfter: Uint<64>,
            invite: Bytes<32>,
            ) {
  assert(seats >= 2, "a table needs at least 2 seats");
  assert(seats <= maxSeats(), "a table holds at most 6 seats");
  // Guarantees `q >= 1` in both rake splits (the pot's at `settle`, and the per-seat one at
  // `abortTable`), so no payment path has to make a zero-value send conditional.
  assert(stake >= minTier(), "tier must be at least 100 so the 1% rake is non-zero");
  // Keeps `tier * seatCount` and `tier * penaltyDenom()` inside `Uint<64>`, so no refund path
  // can be denied by a checked-cast overflow while `settle` still works. See `maxTier`.
  assert(stake <= maxTier(), "tier is above the maximum a table may stake");
  // NOT merely `> 0`. A timeout at or below the declared-time slack lets `closeRound`'s caller
  // under-declare `now` far enough that the next round's deadline has already expired when it
  // opens, and `eliminate` is permissionless -- so opening a round becomes an elimination
  // weapon. See section 5 and docs/security-review.md C1. The floor is strict.
  const timeoutFloor = (timeSlackSecs() * timeoutSlackFactor()) as Uint<64>;
  assert(turnTimeout > timeoutFloor, "turn timeout must exceed four times the declared-time slack");
  assert(tableTimeout > timeoutFloor,
         "table timeout must exceed four times the declared-time slack"
         );

  tableId = disclose(id);
  tier = disclose(stake);
  seatLimit = disclose(seats);
  rakeAddress = disclose(rakeTo);
  seedCommitment = disclose(seedCommit);
  turnTimeoutSecs = disclose(turnTimeout);
  tableTimeoutSecs = disclose(tableTimeout);
  fastMode = disclose(fast);
  // Zero disables early starts. Any positive wait is allowed: the clock is a kernel predicate
  // on the LAST join's pinned time, so there is no declared value for a caller to shade.
  startAfterSecs = disclose(startAfter);
  // Zero = public. The hash is public knowledge by construction; only the preimage is secret.
  inviteHash = disclose(invite);

  phase = Phase.filling;
  roundDigest = genesisDigest(disclose(id));

  // Explicit zero-inits. Every one of these already holds its type's default, so none of it
  // changes behaviour -- it is here so the initial value of a field is a statement in the source
  // rather than an inference about Compact's defaults (docs/security-review.md §5). Two are
  // load-bearing enough to say out loud: `roundDeadline` STAYS 0 so an empty table has no fill
  // clock and cannot be aborted, and `revealedSeed` STAYS zero until a settlement that actually
  // opened the commitment writes it.
  //
  // `padStore` is deliberately NOT initialised: it is a transaction-padding sink, not state, and
  // writing 4 KB here would grow the deploy transaction for no reason.
  seatCount = 0;
  activeSeats = 0;
  openRound = 0;
  roundDeadline = 0;
  pot = 0;
  revealedSeed = default<Bytes<32>>;
  winnerSeatIndex = 0;
  finalDigest = default<Bytes<32>>;
  started = false;
  fillOpenedAt = 0;

  // Pre-insert the three maps that are read AT A FIXED INDEX 0..5, so every runtime `lookup` is
  // total. See section 7.
  //
  // `seatIdentity`, `seatCard` and `seatReceipt` are NOT among them: every lookup of those is at
  // an index the caller has already asserted is below `seatCount`, so `join` writes a seat's
  // three entries when it takes the seat. Moving them off the constructor is not tidiness -- the
  // deploy transaction was REJECTED by the node with "Transaction would exhaust the block
  // limits" while it wrote all six maps, and a scorecard is 27 fields. Six of those, six
  // identities and six receipts is the difference between a deployable contract and one that
  // is not. See docs/e2e-report.md.
  //
  // The three that remain cannot move: `closeRound` and `settle` read `seatProgress` at 0..5,
  // `totalRedeemable` reads `seatRedeemable` at 0..5, and `abortTable`'s `awaitingOperatorAt`
  // reads `seatTurn` at 0..5. A circuit has no branches, so `s < seatCount && ...lookup(s)` does
  // NOT skip the lookup for an absent slot -- the transcript op is emitted either way, and a
  // lookup of an absent key aborts.
  for (const s of 0..6) {
    seatProgress.insert(
      s as Uint<8>,
      SeatProgress { round: 0,
                     total: 0,
                     finishedAtRound: noFinish(),
                     eliminated: false,
                     dice: Dice { d0: 1, d1: 1, d2: 1, d3: 1, d4: 1 }, }
      );
    seatTurn.insert(
      s as Uint<8>,
      SeatTurn { stage: stageIdle(),
                 round: 0,
                 entropy: default<Bytes<32>>,
                 mixed: default<Bytes<32>>,
                 hold1: default<HoldMask>,
                 hold2: default<HoldMask>,
                 roll: Dice { d0: 1, d1: 1, d2: 1, d3: 1, d4: 1 }, }
      );
    seatRedeemable.insert(s as Uint<8>, 0);
    seatPaid.insert(s as Uint<8>, 0);
  }
}

// ===========================================================================================
// join
// ===========================================================================================

/**
 * Take the next seat, stake `tier` in, and register the seat's entropy commitment.
 *
 * `receiveUnshielded` does not name a payer -- it declares "this contract's balance rises by
 * `tier`" and the ledger's transaction-wide per-token balance check forces the surrounding
 * transaction to supply a matching real unshielded input. So the joining wallet authorises its
 * own stake by balancing and signing its own UTXO, and the contract cannot pull funds from
 * anyone (docs/gate0-report.md, Q1).
 *
 * `payoutTo` is recorded here and read at `settle` and `redeem`. A circuit cannot learn its
 * caller, so this is the only way the contract can pay anyone.
 *
 * NOT CONFLICT-FREE, AND THAT IS THE POINT. `join` read-modify-writes `seatCount`, so two
 * simultaneous joins bind to it and exactly one survives with a `ReadMismatch`. That is the
 * behaviour we want: if both landed they would both take the same seat index and one player's
 * identity would be silently overwritten by the other's -- experiment B in
 * docs/concurrency-probe.md, the silent lost write. A rejection the client can retry is
 * strictly better than a stake paid into a seat somebody else owns.
 *
 * The last join flips the table to `playing` and opens round 0 with a full turn timeout.
 */
export circuit join(payoutTo: UserAddress, now: Uint<64>): Uint<8> {
  assert(phase == Phase.filling, "join: table is not filling");
  // Slots, not players: a seat that left while filling keeps its slot (indices are
  // positional), so a table can hold more slots than its limit. The game starts when the
  // number of ACTIVE seats reaches the limit; six slots is the hard ceiling of the maps.
  assert(seatCount < maxSeats(), "join: no free slot");
  assert(activeSeats < seatLimit, "join: table is full");

  const t = disclose(now);
  const who = disclose(payoutTo);
  pinTime(t);

  // A zero payout address is where a stake goes to die: `redeem` and `settle` both pay the
  // address recorded here and nothing else, so a seat that records zeros has staked into a
  // burn. Self-harm rather than an attack, which is why it is a cheap assert -- but a client
  // bug that leaves the field unset should cost a rejected transaction, not a lost stake.
  assert(who != default<UserAddress>, "join: payout address must not be the zero address");

  // The seat's authorisation key. Proving knowledge of `sk` is what every later `playerMove`
  // authorises against; committing to it here is what makes the per-round entropy
  // non-grindable. `entropyKeyCommitment` is a hash, so disclosing it reveals nothing about
  // `sk` -- and it has to be public, since it is the value `playerMove` checks against. It
  // binds `tableId`, so the same secret at two tables produces two unrelated commitments.
  const commit = disclose(entropyKeyCommitment(tableId, playerEntropySecret()));
  assert(!joinedKeys.member(commit), "join: this entropy key already holds a seat");

  // A private table admits only a joiner who knows the invite code. The comparison result is
  // the only thing disclosed -- a boolean -- so a wrong guess reveals nothing about the code.
  const code = inviteCode();
  assert(disclose(inviteHash == default<Bytes<32>> || inviteCommitment(code) == inviteHash),
         "join: this table is private -- the invite code does not match"
         );

  const seat = seatCount;
  // The seat's own three entries, written here rather than pre-inserted by the constructor
  // because every lookup of them is at an index below `seatCount`. See the constructor.
  seatIdentity.insert(seat, SeatIdentity { addr: who, keyCommit: commit });
  seatCard.insert(seat, emptyScorecard());
  seatReceipt.insert(seat, default<Bytes<32>>);
  joinedKeys.insert(commit);

  receiveUnshielded(nativeToken(), tier as Uint<128>);
  pot = (pot + tier) as Uint<64>;

  // Folded into the digest chain here, exactly as under the cursor model. Because seat order is
  // join order and the digest absorbs every join, a player choosing `sk_s` at join time cannot
  // know the digest their later rolls will hash against.
  roundDigest = joinDigest(roundDigest, seat, who, commit);
  const taken = (seatCount + 1) as Uint<8>;
  const active = (activeSeats + 1) as Uint<8>;
  seatCount = taken;
  activeSeats = active;
  fillOpenedAt = t;

  if (active == seatLimit) {
    started = true;
    // Round 0 opens now, and every seat gets a full turn timeout to play its first turn.
    phase = Phase.playing;
    openRound = 0;
    roundDeadline = (t + turnTimeoutSecs) as Uint<64>;
  } else {
    // The fill clock. Restarted by every join, so a table that is still attracting players is
    // never abortable, and one that stops attracting them becomes abortable a table-timeout
    // later. Under-declaring `now` here only brings the declarer's own table's abort forward,
    // and an abort is a full refund, so there is nothing to gain.
    roundDeadline = (t + tableTimeoutSecs) as Uint<64>;
  }

  padTransaction();
  return seat;
}

// ===========================================================================================
// playerMove -- open a turn, hold dice, or score and stop
// ===========================================================================================

/**
 * THE player's entry point, and the only one. Three moves in one circuit.
 *
 * ---------------------------------------------------------------------------------------------
 * WHY ONE CIRCUIT AND NOT THREE
 * ---------------------------------------------------------------------------------------------
 *
 * The interactive turn has three player moves -- open, hold, score -- where the pre-declared
 * turn had one. Exported as separate circuits they would take the contract to TWELVE, against a
 * deploy ceiling measured at 11-12 on this toolchain. That is too close to a limit whose exact
 * value nobody has pinned, for a contract holding real stakes.
 *
 * So they are merged behind a `kind` discriminator with canonical sentinels for the arguments a
 * kind does not use, which is the same pipelined-sentinel style the old `takeTurn` already used
 * for its two end rounds. A circuit has no branches, so merging costs nothing at proving time
 * that three circuits would not each have paid anyway: the union of the three read sets is what
 * every kind reads regardless.
 *
 * ---------------------------------------------------------------------------------------------
 * THE ARGUMENT ENCODING -- also in docs/table-interface.md, which the client is written from
 * ---------------------------------------------------------------------------------------------
 *
 *   kind = 0  OPEN    entropy = H(sk, tableId, openRound)   mask = 00000   category = 0
 *   kind = 1  HOLD    entropy = 32 zero bytes                mask = chosen   category = 0
 *   kind = 2  SCORE   entropy = 32 zero bytes                mask = 00000   category = 0..12
 *
 * The unused arguments must carry EXACTLY those values. Canonicity is not fussiness: the moves
 * are part of the public log a settlement verifier replays, and two encodings of one move would
 * make that log ambiguous.
 *
 * ---------------------------------------------------------------------------------------------
 * AUTHORISATION AND ENTROPY
 * ---------------------------------------------------------------------------------------------
 *
 * ALL THREE KINDS prove knowledge of the seat's `sk_s` against the `C_s` recorded at join. That
 * is not optional for hold and score: without it anyone could hold nothing and score a seat's
 * dice into its worst category.
 *
 * `entropy` is BOTH supplied and re-derived, on OPEN only. The circuit proves
 * `entropy == H(sk, tableId, r)`, so a player cannot choose their entropy at turn time at all --
 * only reveal the one value their join-time commitment already fixed. Supplying it as an
 * argument costs one hash and buys a distinguishable failure: a wrong secret and a wrong entropy
 * are different errors, which matters when the client is the thing that is broken.
 *
 * `seat` IS AN ARGUMENT AND THAT IS SAFE, even though the concurrency probe's silent-lost-write
 * hazard says a map key must be derived from the actor. The key is not the authorisation: the
 * `C_s` check means a transaction writing seat 3 can only be produced by someone holding seat
 * 3's secret. Deriving the index by scanning all six identities would be the same guarantee at
 * the cost of six binding reads -- which is exactly the collision the layout exists to avoid.
 *
 * ---------------------------------------------------------------------------------------------
 * CONFLICT-FREEDOM
 * ---------------------------------------------------------------------------------------------
 *
 * Everything else in this contract exists to let this circuit write only `seatCard[seat]`,
 * `seatProgress[seat]` and `seatTurn[seat]`, and read nothing that can move while it is in
 * flight. Six seats submitting in the same instant all land, in one block -- measured at that
 * exact width in docs/concurrency-probe.md, experiment G. src/test/ledger-access.ts re-derives
 * the read set from the compiled transcript on every test run, so the claim cannot rot.
 */
export circuit playerMove(
                 seat: Uint<8>,
                 kind: Uint<8>,
                 entropy: Bytes<32>,
                 mask: Vector<5, Boolean>,
                 category: Uint<8>,
                 ): Uint<8> {
  assert(phase == Phase.playing, "playerMove: table is not playing");

  const s = disclose(seat);
  const k = disclose(kind);
  const e = disclose(entropy);
  const m = disclose(mask);
  const cat = disclose(category);

  assert(s < seatCount, "playerMove: no such seat");
  assert(k < moveKindCount(), "playerMove: unknown move kind");

  const r = openRound;
  assert(r < roundCount(), "playerMove: the game is over");

  const opening = k == moveOpen();
  const holding = k == moveHold();
  const scoring = k == moveScore();

  // ---- canonical sentinels ------------------------------------------------------------
  // The unused arguments carry a fixed value so the public log has one representation of each
  // move. Cheap asserts; they are the difference between a replayable log and an ambiguous one.
  assert(opening || e == default<Bytes<32>>,
         "playerMove: only an open declares entropy -- pass 32 zero bytes"
         );
  assert(holding || (!m[0] && !m[1] && !m[2] && !m[3] && !m[4]),
         "playerMove: only a hold declares a mask -- pass all-false"
         );
  assert(scoring || cat == 0, "playerMove: only a score declares a category -- pass 0");

  // ---- authorisation: knowledge of this seat's entropy secret -------------------------
  const sk = playerEntropySecret();
  assert(disclose(entropyKeyCommitment(tableId, sk) == seatIdentity.lookup(s).keyCommit),
         "playerMove: wrong entropy secret for this seat"
         );
  assert(disclose(!opening || forcedEntropy(sk, tableId, r) == e),
         "playerMove: entropy is not H(sk, tableId, round)"
         );

  const prog = seatProgress.lookup(s);
  const pend = seatTurn.lookup(s);

  // ---- is this move legal in this state? ----------------------------------------------
  //
  // Opening needs a seat that owes the round and has not started it. Holding and scoring need a
  // turn that is between rolls -- the seat's own state carries the rest, and an eliminated seat
  // is unreachable from all three because `eliminate` sets `round` to `roundCount()` and `stage`
  // to idle.
  assert(!prog.eliminated, "playerMove: this seat has been eliminated");
  assert(!opening || prog.round == r, "playerMove: this seat has already played the open round");
  assert(!opening || pend.stage == stageIdle(), "playerMove: this seat already opened its turn");
  const between = pend.stage == stageRolled1() ||
                  pend.stage == stageRolled2() ||
                  pend.stage == stageRolled3();
  assert(!holding || pend.stage == stageRolled1() || pend.stage == stageRolled2(),
         "playerMove: a hold needs a resolved roll with another roll left"
         );
  assert(!scoring || between, "playerMove: nothing has been rolled to score");

  // ---- score ---------------------------------------------------------------------------
  const card = seatCard.lookup(s);
  const d = fromDice(pend.roll);
  const outcome = applyScore(cat, d, card.filled, card.scores[11]);
  assert(!scoring || outcome.validPlacement,
         "playerMove: illegal placement -- box taken, or joker rules violated"
         );

  // NOT `cardTotal(placeScore(...))`: that reads the new score nineteen times and took a
  // measured compile from 12 s to 187 s. `totalAfterPlacing` reads it twice.
  const newTotal = totalAfterPlacing(card, cat, outcome.score, outcome.bonusEarned);
  const newCard = placeScore(card, cat, d);

  // The completeness assert is an invariant check, not a rule -- thirteen rounds each taking a
  // distinct open category can only end with a full card -- and it is here so a round-accounting
  // bug shows up as a failed transaction rather than as a settled game with a wrong total.
  const finishing = scoring && r == finalRound();
  assert(!finishing || isComplete(newCard), "playerMove: the last round must complete the card");

  if (scoring) {
    seatCard.insert(s, newCard);
    seatProgress.insert(
      s,
      SeatProgress { round: (r + 1) as Uint<8>,
                     total: newTotal,
                     finishedAtRound: finishing ? (r as Uint<16>) : prog.finishedAtRound,
                     // Preserved rather than hard-coded false. An eliminated seat cannot reach
                     // here (asserted above), but writing the invariant down is cheaper than
                     // relying on it.
                     eliminated: prog.eliminated,
                     // What `closeRound` folds into the round digest.
                     dice: pend.roll, }
      );
  }

  // ---- the turn's next stage -----------------------------------------------------------
  //
  // Open moves to "awaiting roll 1"; a hold moves to the next odd stage, which is the operator's
  // to discharge; a score returns the seat to idle for the next round.
  const nextStage =
          opening
            ? stageAwaitRoll1()
            : (holding
                 ? (pend.stage == stageRolled1() ? stageAwaitRoll2() : stageAwaitRoll3())
                 : stageIdle());

  seatTurn.insert(
    s,
    SeatTurn { stage: nextStage,
               round: r,
               // Written on open, carried afterwards. A hold or a score cannot change it -- the
               // sentinel assert above already forces `e` to zeros for those kinds.
               entropy: opening ? e : pend.entropy,
               // Latched by resolveRoll1; nothing to write here. Cleared on open so a turn never
               // inherits the previous round's mix.
               mixed: opening ? default<Bytes<32>> : pend.mixed,
               // A hold writes the mask for the roll it precedes and leaves the other alone;
               // opening a turn clears both so a turn never inherits the previous round's.
               hold1: opening
                        ? default<HoldMask>
                        : (holding && pend.stage == stageRolled1()
                             ? HoldMask { bits: m }
                             : pend.hold1),
               hold2: opening
                        ? default<HoldMask>
                        : (holding && pend.stage == stageRolled2()
                             ? HoldMask { bits: m }
                             : pend.hold2),
               roll: pend.roll, }
    );

  padTransaction();
  return nextStage;
}

// ===========================================================================================
// resolveRoll1 / resolveRoll2 / resolveRoll3 -- the operator's move, one roll per transaction
// ===========================================================================================
//
// This is the one place ZK genuinely earns its keep in the base game. The seed stays a private
// witness -- each circuit proves `H(tableId, seed) == seedCommitment` without revealing `seed`
// -- so the dice are proven correct against a commitment made before any player existed, while
// the game is still live and the player still must not know the seed.
//
// Authorisation is knowledge of the seed and nothing else, in all three steps. There is no
// operator address anywhere in this contract. Re-checking the seed in every step is not
// redundant: each step derives a roll from it.
//
// THE SEAT IS AN ARGUMENT. Under the cursor model the operator resolved whoever `currentSeat`
// named; under simultaneous rounds up to six seats can be awaiting a roll at once, so the
// operator has to say which. That is not discretion over outcomes -- a seat's dice are fixed by
// the frozen round digest, its own forced entropy and the seed, so the order the operator picks
// changes nothing about what any seat receives (section 2 of the header).
//
// THE ROLL INPUTS ARE `H(tableId, seed, mixEntropy(entropy_s(r), roundDigest_r), r, rollIndex)`,
// and `roundDigest_r` is the digest FROZEN AT ROUND OPEN. `resolveRoll1` latches the mixed
// entropy into the seat's own pipeline so all three rolls hash against the same value.
//
// NO TIME CHECK, IN ANY OF THE THREE. A resolve is never late: `eliminate` refuses a seat whose
// next move is the operator's, and an operator that abandons one mid-turn is `abortTable`'s
// business. Adding a deadline here would only give the operator a way to lose a seat's move to
// the clock.
//
// WHY THREE TRANSACTIONS AND NOT ONE: the single-circuit version compiles to k=17 and the proof
// server has no SRS above 15. The measured corpus forces the cut at one roll per transaction:
// one roll is k=15, two are k=16. With interactive holds the cut is no longer a compromise
// anyway -- the player has to see each roll to choose the next hold, so the rolls MUST be
// separate transactions.

/**
 * Roll 1 of 3: five fresh dice for one seat, and the latch of that seat's mixed entropy.
 *
 * Nothing is held: the player has not seen anything yet. Under pre-declared policies this step
 * also checked a witnessed modal face and computed the hold mask, which is where its
 * instruction count went; both are gone.
 *
 * Touches exactly ONE map, and that is deliberate -- this circuit is at k=15 with no headroom.
 */
export circuit resolveRoll1(seat: Uint<8>): Dice {
  assert(phase == Phase.playing, "resolveRoll1: table is not playing");

  const s = disclose(seat);
  const t = seatTurn.lookup(s);
  assert(t.stage == stageAwaitRoll1(), "resolveRoll1: this seat is not awaiting its first roll");
  // The digest below is the OPEN round's. A pending turn from another round would derive its
  // dice from the wrong entropy, so pin the two together rather than trusting `closeRound`'s
  // own guard to have held. Reading `openRound` is free: it cannot move while a roll is pending.
  assert(t.round == openRound, "resolveRoll1: pending turn is not in the open round");

  const seed = rollSeed();
  assert(disclose(seedCommitmentOf(tableId, seed) == seedCommitment),
         "resolveRoll1: seed does not open the table's seed commitment"
         );

  // `mixed` needs NO `disclose`, and the asymmetry is the point: it is a hash of the seat's
  // entropy and the round digest, both public ledger reads, so anyone could already compute it.
  // The dice below DO need one, because they depend on `seed`.
  const mixed = mixEntropy(t.entropy, roundDigest);
  const dice = disclose(toDice(firstRoll(tableId, seed, mixed, t.round)));

  seatTurn.insert(
    s,
    SeatTurn { stage: stageRolled1(),
               round: t.round,
               entropy: t.entropy,
               mixed: mixed,
               hold1: t.hold1,
               hold2: t.hold2,
               roll: dice, }
    );

  padTransaction();
  return dice;
}

/**
 * Rolls 2 AND 3: reroll exactly the positions the player did not hold.
 *
 * ONE CIRCUIT FOR BOTH REROLLS, and the merge is forced by a limit nobody had measured. See
 * section 8 of this header: the deploy transaction carries one verifier key per exported
 * circuit, and at ten circuits it is refused by the node with "Transaction would exhaust the
 * block limits". Nine deploy; ten do not. So one circuit had to go, and these two were the
 * right pair to lose:
 *
 *   * they are the SAME computation. Roll 2 and roll 3 differ only in which roll hash they
 *     draw from and which of the two stored masks they apply -- both of which the seat's own
 *     `stage` already determines, so the merge needs no new argument and grants the operator no
 *     new discretion.
 *   * merging them costs no PLONK step. The domain of a reroll is set by the roll hash and its
 *     rejection ladder -- 30 `div_mod_power_of_two` and ~120 `less_than` -- and the merge adds
 *     seven conditional selects to that. Measured at k=15 before and after, which is the only
 *     reason this pair was chosen over any other: every other candidate merge either doubled a
 *     hash or joined two circuits with different read sets.
 *   * it SIMPLIFIES the operator, which was already dispatching on the stage to decide which of
 *     `resolveRoll2` and `resolveRoll3` to call.
 *
 * The fresh roll is consumed LEFT TO RIGHT over the rerolled positions -- see `mergeStream` in
 * policy-core.compact. Writes no seat progress: the turn is still in progress and the player may
 * still stop and score after either reroll.
 */
export circuit resolveReroll(seat: Uint<8>): Dice {
  assert(phase == Phase.playing, "resolveReroll: table is not playing");

  const s = disclose(seat);
  const t = seatTurn.lookup(s);
  const second = t.stage == stageAwaitRoll2();
  const third = t.stage == stageAwaitRoll3();
  assert(second || third, "resolveReroll: this seat is not awaiting a reroll");

  const seed = rollSeed();
  assert(disclose(seedCommitmentOf(tableId, seed) == seedCommitment),
         "resolveReroll: seed does not open the table's seed commitment"
         );

  // Which mask and which roll hash, decided by the seat's own stage and by nothing else. The
  // two hold cells exist precisely so that this selection is a read rather than a rewrite.
  const hold = second ? t.hold1.bits : t.hold2.bits;
  const rollIndex = (second ? 1 : 2) as Uint<8>;

  const dice = disclose(toDice(rerollUnderMask(
                                 tableId,
                                 seed,
                                 t.mixed,
                                 t.round,
                                 rollIndex,
                                 hold,
                                 fromDice(t.roll)
                                 )
                               ));

  seatTurn.insert(
    s,
    SeatTurn { stage: second ? stageRolled2() : stageRolled3(),
               round: t.round,
               entropy: t.entropy,
               mixed: t.mixed,
               hold1: t.hold1,
               hold2: t.hold2,
               roll: dice, }
    );

  padTransaction();
  return dice;
}

// ===========================================================================================
// closeRound
// ===========================================================================================

/**
 * Advance the whole table one round: freeze a new digest, open the next round, restamp the
 * deadline.
 *
 * THE ONLY WRITER OF `openRound`, `roundDigest` AND (while playing) `roundDeadline`. That
 * exclusivity is what makes those three safe for six simultaneous turns to read: they cannot
 * move while any seat still has a move to make, because this circuit refuses to run until every
 * seat has finished.
 *
 * Permissionless. Every input is public ledger state and the outcome is fully determined, so
 * there is no discretion to abuse -- the operator will normally call it because it is watching
 * anyway, but a player whose operator has gone quiet can advance the table itself.
 *
 * A SEPARATE CIRCUIT AND NOT PART OF A RESOLVE for a hard reason: `resolveRoll1/2/3` are at k=15
 * with zero headroom and the proof server has no SRS above 15. Folding a six-seat read and a
 * `persistentHash` over 36 bytes of results into the roll path would make the contract
 * unprovable rather than slow. With interactive holds there is no resolve it could sensibly be
 * folded into anyway, since a turn may end after any of the three.
 *
 * Reads all six `seatProgress` entries and therefore binds to all six. That is fine and in fact
 * necessary: it must observe a consistent snapshot in which every seat is finished, and if a
 * seat moves underneath it the transaction should fail rather than close a round that is not
 * over.
 */
export circuit closeRound(now: Uint<64>): Uint<8> {
  assert(phase == Phase.playing, "closeRound: table is not playing");

  const r = openRound;
  assert(r < roundCount(), "closeRound: the game is already over");

  const t = disclose(now);
  pinTime(t);

  const p0 = seatProgress.lookup(0);
  const p1 = seatProgress.lookup(1);
  const p2 = seatProgress.lookup(2);
  const p3 = seatProgress.lookup(3);
  const p4 = seatProgress.lookup(4);
  const p5 = seatProgress.lookup(5);

  const n = seatCount;
  assert(seatDone(p0, 0, n, r) &&
         seatDone(p1, 1, n, r) &&
         seatDone(p2, 2, n, r) &&
         seatDone(p3, 3, n, r) &&
         seatDone(p4, 4, n, r) &&
         seatDone(p5, 5, n, r),
         "closeRound: not every seat has finished the open round"
         );

  roundDigest =
    roundDigestOf(
      roundDigest,
      r,
      n,
      [roundResultOf(p0),
       roundResultOf(p1),
       roundResultOf(p2),
       roundResultOf(p3),
       roundResultOf(p4),
       roundResultOf(p5),]
      );
  const next = (r + 1) as Uint<8>;
  openRound = next;
  // Restamped even for the final close, because `settle`'s seed-waiver deadline is measured from
  // it: the operator gets one more table timeout past the end of the game to produce the seed
  // before anyone may force-settle without it.
  roundDeadline = (t + turnTimeoutSecs) as Uint<64>;

  padTransaction();
  return next;
}

/**
 * Has this slot finished round `r`?
 *
 * True for a slot that does not exist at this table, and for an eliminated seat -- neither owes
 * the round. A live seat is finished when `playerMove(score)` has moved its cursor past `r`,
 * which also returned its `stage` to idle, so this one read settles the question.
 */
pure circuit seatDone(p: SeatProgress, s: Uint<8>, n: Uint<8>, r: Uint<8>): Boolean {
  return s >= n || p.eliminated || p.round > r;
}

/** One seat's contribution to the round digest. */
pure circuit roundResultOf(p: SeatProgress): RoundResult {
  return RoundResult { dice: p.dice, out: p.eliminated };
}

// ===========================================================================================
// eliminate
// ===========================================================================================

/**
 * Knock out a seat that let the round deadline pass, and split its stake.
 *
 * Permissionless, pays the caller nothing, and takes nothing that a wait would not have taken
 * anyway -- so there is no incentive to grief and no reason to race. Anyone can unstick a table
 * whose player has walked away.
 *
 * IT COVERS EVERY PLAYER-OWED SUB-STATE, which with interactive holds is four of them rather
 * than one: a seat that never opened its turn (`stage == 0`), one that opened and saw roll 1 but
 * never sent a hold or a score (`stage == 2`), the same after roll 2 (`stage == 4`), and one
 * that rolled three times and never scored (`stage == 6`). All four are the player's silence.
 * The odd stages -- 1, 3 and 5 -- are the operator's, and `eliminate` refuses them: punishing a
 * player for the operator's failure to resolve would punish the wrong party, and it is the
 * operator that can grief by withholding resolution. `abortTable` is the remedy for that, and it
 * refunds everyone.
 *
 * THE PENALTY IS `tier * (r + 1) / penaltyDenom()`, where `r` is the round the seat failed in. A
 * thirteenth for the first round, all of it for the last: the more you have played, the more you
 * cost the others by leaving. The forfeited share STAYS IN THE POT and goes to the winner, which
 * is the compensation. The rest becomes the seat's `redeemable` and leaves the pot, so the
 * winner can never be paid an eliminated player's refund.
 *
 * Compact has no division, so the split is the same witness-and-assert identity the rake uses:
 * the caller supplies `q` and `rem` with `q * penaltyDenom() + rem == tier * (r + 1)` and
 * `rem < penaltyDenom()`, which has exactly one solution. `q` is the penalty.
 *
 * The `+ 1` reconciles two numbering schemes and is not an off-by-one:
 * docs/simultaneous-rounds.md numbers the penalty over rounds 1..13, and this contract numbers
 * its thirteen rounds 0..12. A seat that never moves at all forfeits a thirteenth rather than
 * nothing, which is the case the penalty most needs to cover.
 *
 * WHEN THE LAST ACTIVE SEAT GOES, the table becomes `abandoned` -- there is nobody left to play
 * and nobody who earned the pot. `abortTable` then applies the waiver (decision 1 of
 * docs/simultaneous-rounds.md) and opens `redeem`. Deliberately not "the last seat standing
 * wins": the last seat also walked away, and paying it would make timing out last profitable.
 *
 * k BALLAST, DECLARED. This circuit would otherwise be small enough to fall under the node's
 * proof-size admission floor -- the shape that made `claimTimeout` (k=11) fail 1,610 times. Two
 * things lift it and both are worth doing: `assertCustody()`, which is the check that catches a
 * pot/redeemable arithmetic slip at the exact moment money moves between the two, and the
 * `seatReceipt` hash, which records the penalty arithmetic publicly and permanently. Measured
 * before being kept. See section 3 of the header.
 *
 * ---------------------------------------------------------------------------------------------
 * VOLUNTARY RESIGNATION rides the same circuit (a tenth circuit is over the deploy ceiling).
 * With `voluntary` set, the caller proves knowledge of the SEAT'S OWN entropy secret -- the
 * exact authorisation `playerMove` demands -- and in exchange three involuntary-only guards are
 * waived: the round deadline (you may leave now, not when the clock says so), the player-owes
 * stage parity (you may leave while a resolve is in flight; returning the turn to idle below
 * makes the in-flight resolve unlandable, which is correct -- the dice were for a game you have
 * left), and the played-this-round check (you may leave right after scoring, without waiting
 * for the next round to open). The PENALTY IS IDENTICAL -- `tier * (openRound + 1) / 13` -- so
 * resigning is never cheaper than being timed out at the same point, only faster for everyone:
 * with the walkover in `settle`, a two-player resignation pays the survivor and unlocks the
 * resigner's redeem about a minute later, instead of after a full round clock.
 *
 * THE INCENTIVE: a resignation is charged one round less than a timeout at the same point --
 * `tier * openRound / 13` instead of `tier * (openRound + 1) / 13`. Leaving loudly is always
 * strictly cheaper than leaving silently, which is the point: a leaver who presses the button
 * costs the table a minute; one who walks away costs it the whole round clock. The corollary is
 * accepted deliberately: resigning during round one is free (0/13), so a join-and-quit costs
 * only fees -- tolerable on a demo, and the griefed opponent is made whole by the walkover
 * settle minus the rake.
 *
 * A false `voluntary` is byte-for-byte the old circuit: the witness is still invoked (circuits
 * have no conditional calls), but its value only reaches an assertion behind `voluntary`, so
 * the operator's placeholder secret proves nothing and gates nothing.
 */
export circuit eliminate(seat: Uint<8>, q: Uint<64>, rem: Uint<64>, voluntary: Boolean): Uint<64> {
  const s = disclose(seat);
  assert(s < seatCount, "eliminate: no such seat");

  const vol = disclose(voluntary);
  // A FILLING table may be left voluntarily -- and only voluntarily: nobody owes anything
  // before the game starts, so there is no silence to punish. `openRound` is 0 while filling,
  // so the resignation schedule below charges `tier * 0 / 13 == 0`: a full refund, with the
  // same witness split the caller already knows how to compute.
  const leaving = phase == Phase.filling && vol;
  assert(phase == Phase.playing || leaving, "eliminate: table is not playing");
  // Resignation is self-authorised: knowing the seat's entropy secret is exactly what playerMove
  // accepts as "being" the seat. Nothing about the secret leaks -- the commitment is already on
  // chain, the comparison is boolean.
  const sk = playerEntropySecret();
  assert(disclose(!vol || entropyKeyCommitment(tableId, sk) == seatIdentity.lookup(s).keyCommit),
         "eliminate: resigning needs this seat's own entropy secret"
         );

  const r = openRound;
  assert(r < roundCount(), "eliminate: the game is over");
  assert(vol || blockTimeGt(roundDeadline), "eliminate: the round deadline has not passed");

  const prog = seatProgress.lookup(s);
  assert(!prog.eliminated, "eliminate: this seat is already out");
  assert(vol || prog.round == r, "eliminate: this seat has already played the open round");

  const pend = seatTurn.lookup(s);
  // On a FAST table the stage-parity shield is waived: resolves are off-chain there, so a seat
  // parked at stage 1 past the deadline is a stalled fast turn, not an operator debt -- and
  // between transactions a fast seat can rest at no other odd stage. On-chain-mode tables keep
  // the rule exactly: an odd stage is the operator's silence and eliminating it would punish
  // the wrong party.
  assert(vol || fastMode || playerOwes(pend.stage),
         "eliminate: this seat is waiting on the operator, not the other way round"
         );

  // Rounds are 0..12 here and 1..13 in the design note. See the doc comment. A RESIGNATION IS
  // CHARGED ONE ROUND LESS: the open round does not count, so hitting the button during round
  // ten costs 9/13 where letting round ten time out costs 10/13 -- the deliberate incentive to
  // leave loudly instead of silently (and in round one, resigning is a free exit). The identity
  // below pins whichever `charged` applies, so a resigner cannot claim the timeout rate or vice
  // versa: `voluntary` is a public argument and the verifier recomputes the schedule from it.
  const charged = (vol ? (r as Uint<64>) : ((r + 1) as Uint<64>));
  const penalty = disclose(q);
  const slack = disclose(rem);
  // Field arithmetic on both sides, no narrowing cast: a checked cast here would abort instead
  // of failing the assert on an over-large `q`, which is a worse error to debug.
  assert(penalty * penaltyDenom() + slack == tier * charged,
         "eliminate: penalty must satisfy q * 13 + rem == tier * (round + 1)"
         );
  assert(slack < penaltyDenom(), "eliminate: penalty remainder must be below 13");
  // Implied by `charged <= 13`, asserted anyway so a bad `charged` can never mint money.
  assert(penalty <= tier, "eliminate: penalty cannot exceed the stake");

  const refund = (tier - penalty) as Uint<64>;

  seatProgress.insert(
    s,
    SeatProgress { round: roundCount(),
                   total: prog.total,
                   // An eliminated seat never completed its card, so it loses every tie-break it
                   // would otherwise have drawn -- and `settle` excludes it from the winner
                   // computation outright. Written for the record either way.
                   // A pre-start leaver is marked apart for good: see `leftBeforeStart`.
                   finishedAtRound: leaving ? leftBeforeStart() : noFinish(),
                   eliminated: true,
                   dice: prog.dice, }
    );

  // Returning the turn to idle is not tidiness: it is what makes a half-played turn unreachable
  // afterwards, so a `playerMove(hold)` that was already in flight cannot land on a seat that
  // has left the game.
  seatTurn.insert(
    s,
    SeatTurn { stage: stageIdle(),
               round: pend.round,
               entropy: pend.entropy,
               mixed: pend.mixed,
               hold1: pend.hold1,
               hold2: pend.hold2,
               roll: pend.roll, }
    );

  // The forfeited share stays behind; the rest leaves the pot for good.
  pot = (pot - refund) as Uint<64>;
  seatRedeemable.insert(s, (seatRedeemable.lookup(s) + refund) as Uint<64>);
  seatReceipt.insert(
    s,
    eliminateDigest(seatReceipt.lookup(s), tableId, s, r, tier, penalty, refund)
    );

  const remaining = (activeSeats - 1) as Uint<8>;
  activeSeats = remaining;
  // Only a table that was PLAYING is abandoned when its last player goes. A filling table
  // everyone has left is simply empty again -- its slots are spent but it holds no money, and
  // the next arrivals may still fill it (or the fill clock closes it, sharing nothing).
  if (remaining == 0 && phase == Phase.playing) {
    phase = Phase.abandoned;
  }

  assertCustody();

  padTransaction();
  return refund;
}

// ===========================================================================================
// settle
// ===========================================================================================

/**
 * Pay the winner and the rake out of the pot, and reveal the seed.
 *
 * Permissionless: every input is on-chain except the seed, and the seed is checked against the
 * commitment, so the outcome is fully determined by public state. `seed` is a PUBLIC argument
 * here, unlike in the resolves -- the whole point of settlement is that anyone can then
 * re-derive every roll of the game from the public log with the TypeScript mirror and no chain
 * access.
 *
 * ELIMINATED SEATS CANNOT WIN. Under the cursor model a forfeited seat still competed with
 * whatever it had scored. Under simultaneous rounds elimination is permanent and economic -- the
 * seat has already been given back `tier - penalty` -- so letting it also take the pot would pay
 * it twice. Decision 2 of docs/simultaneous-rounds.md: "a seat that misses a round is out of the
 * game". The tie-break among survivors is unchanged: highest total, then a completer over a
 * non-completer, then the lowest seat index.
 *
 * `q` and `r` are supplied, not trusted: `splitPot` asserts `q * 100 + r == pot` and `r < 100`,
 * which has exactly one solution, so the caller cannot inflate the rake.
 *
 * ---------------------------------------------------------------------------------------------
 * THE SEED CHECK IS WAIVED ONCE THE TABLE DEADLINE HAS PASSED, and this is the one place in the
 * contract where a check is deliberately dropped.
 *
 * THE TRAP it closes. A game that runs to completion lands in (`playing`, `openRound == 13`).
 * `playerMove`, `closeRound` and `eliminate` all refuse it, and `abortTable` refuses it too (no
 * seat has a roll in flight). `settle` is the only exit, and if `settle` needed the operator's
 * seed then an operator that vanished -- or simply lost its seed file -- would lock every stake
 * permanently. That breaks the design's core invariant, that every reachable state has a
 * permissionless exit.
 *
 * WHY WAIVING IS SOUND. Nothing about the payout depends on the seed. The winner is a function
 * of public ledger state built up by circuits that each already proved their dice against the
 * commitment as they ran. The rake split is pinned by the Euclidean identity. The payout
 * addresses were recorded at `join`. The seed reveal was never load-bearing for SOUNDNESS -- it
 * is load-bearing for VERIFIABILITY.
 *
 * WHAT IS LOST. A force-settled game is unverifiable after the fact: `revealedSeed` stays zero,
 * so nobody -- including the players -- can re-derive the rolls, and the verifier must report
 * the game as unverified rather than as verification-failed. The dice were still proven correct
 * one transaction at a time while the game was live.
 *
 * WHY IT PAYS THE WINNER RATHER THAN REFUNDING. An operator that had also seated a player (which
 * the threat model forbids but the contract cannot detect) could watch that seat lose and then
 * decline to settle, converting the loss into a refund. Paying the winner the game already
 * produced removes every incentive to reach the timeout at all.
 *
 * `settle` takes no `now`: the deadline is evaluated by the kernel against real block time, so
 * there is nothing to declare and nothing to under-declare.
 *
 * ---------------------------------------------------------------------------------------------
 * THE WALKOVER. A game may also settle BEFORE thirteen rounds when exactly one active seat
 * remains. Nobody can join a table once it is playing, and `winnerSeat` already restricts
 * eligibility to non-eliminated seats, so with `activeSeats == 1` the winner is decided no
 * matter what else happens -- eleven more solo rounds would change nothing but the calendar.
 * Settling immediately pays the survivor and, just as importantly, unlocks every eliminated
 * seat's `redeem`, which is gated on a terminal phase.
 *
 * The walkover cannot be forced: `eliminate` only fires on a seat that owes a move past the
 * round deadline, so the sole-survivor state is reachable only through opponents genuinely
 * timing out. And it stays subordinate to the all-eliminated waiver -- an operator whose last
 * active seat is itself delinquent can eliminate it instead, reaching `abandoned` where every
 * penalty is refunded; this circuit merely permits the early exit, the operator's published
 * policy (service/src/lifecycle.ts) decides which applies. `activeSeats` was already read and
 * asserted below, so this adds no ledger binding that was not here before.
 */
export circuit settle(seed: Bytes<32>, q: Uint<64>, r: Uint<64>): Uint<8> {
  assert(phase == Phase.playing, "settle: table is not playing");
  assert(openRound >= roundCount() || activeSeats == 1,
         "settle: the game is not finished and more than one seat is still playing"
         );
  assert(activeSeats > 0, "settle: no seat is left to pay");

  const s = disclose(seed);
  const opens = seedCommitmentOf(tableId, s) == seedCommitment;
  const graceExpired = blockTimeGt((roundDeadline + tableTimeoutSecs) as Uint<64>);
  assert(opens || graceExpired, "settle: seed does not open the table's seed commitment");

  assertCustody();

  const n = seatCount;
  const winner = winnerSeat(
                   [survivorRow(0, n, seatProgress.lookup(0)),
                    survivorRow(1, n, seatProgress.lookup(1)),
                    survivorRow(2, n, seatProgress.lookup(2)),
                    survivorRow(3, n, seatProgress.lookup(3)),
                    survivorRow(4, n, seatProgress.lookup(4)),
                    survivorRow(5, n, seatProgress.lookup(5)),]
                   );

  const split = splitPot(pot, disclose(q), disclose(r));
  sendUnshielded(
    nativeToken(),
    split[0] as Uint<128>,
    right<ContractAddress, UserAddress>(seatIdentity.lookup(winner).addr)
    );
  sendUnshielded(
    nativeToken(),
    split[1] as Uint<128>,
    right<ContractAddress, UserAddress>(rakeAddress)
    );

  pot = 0;
  // Zero on a force-settle, and that zero is the game's "unverified" marker. A seed that did NOT
  // open the commitment must never be written here: it would look exactly like a reveal while
  // opening nothing, which is worse than an honest blank.
  revealedSeed = opens ? s : default<Bytes<32>>;
  winnerSeatIndex = winner;
  finalDigest =
    finalDigestOf(
      roundDigest,
      tableId,
      Phase.settled as Uint<8>,
      winner,
      n,
      split[0],
      split[1],
      0,
      opens
      );
  phase = Phase.settled;

  padTransaction();
  return winner;
}

/**
 * One row for the winner tie-break. Only a real, un-eliminated seat is eligible.
 *
 * `winnerSeat` returns 0 when no row is active, which `settle` rules out with `activeSeats > 0`.
 */
pure circuit survivorRow(s: Uint<8>, n: Uint<8>, p: SeatProgress): SeatTotal {
  return SeatTotal { seat: s,
                     total: p.total,
                     finishedAtTurn: p.finishedAtRound,
                     active: s < n && !p.eliminated, };
}

// ===========================================================================================
// redeem
// ===========================================================================================

/**
 * Pay one seat the money that is owed to it personally, and write its receipt.
 *
 * Permissionless -- it pays the address seat `s` recorded at `join` and nothing else, so a
 * third party calling it can only do the seat a favour. Idempotent by assertion: the balance is
 * zeroed before the send and a second call finds nothing to pay.
 *
 * ONLY ONCE THE TABLE IS TERMINAL, never while it is live. That is decision 4 of
 * docs/simultaneous-rounds.md and it is what keeps the custody invariant to a single line:
 * nothing is paid out mid-game, so the all-eliminated waiver can be applied uniformly at the end
 * with no claw-back and no top-up. The cost is latency for an eliminated player -- someone
 * knocked out in round 2 waits for the game to end before withdrawing -- and it is accepted
 * deliberately: the alternative needs per-seat withdrawal history and delta payments, which is
 * more state and more ways to get custody wrong, for money that is not at risk either way.
 *
 * `abandoned` IS NOT REDEEMABLE, and this is the one place the phase list is shorter than the
 * design note's. An all-eliminated table still has the penalties sitting in `pot` and every
 * seat's `redeemable` still net of its penalty; paying those out would hand each seat less than
 * the waiver promises and strand the pot. One permissionless `abortTable` call applies the
 * waiver and moves the table to `aborted`, after which this circuit pays the right number. See
 * `abortTable`.
 *
 * CONFLICT-FREE, so six seats can withdraw in one block: it reads `phase` (terminal, so frozen),
 * the sealed config, and its own three map entries.
 *
 * k BALLAST, DECLARED. Paying one number to one address is far too little work to clear the
 * node's proof-size admission floor -- the exact shape that made `claimTimeout` (k=11) fail
 * 1,610 times with `OutsideTimeToDismiss`. `redeemDigest` is what lifts it: a domain-separated
 * `persistentHash` over data this circuit already touches (the table id, the seat, the amount,
 * the payee, and the seat's final scorecard). It is ballast in the sense that it was added for
 * k, and real work in the sense that the receipt is worth having -- it binds a payout to the
 * card it was paid against, publicly and permanently, which is exactly what a player disputing
 * a settlement would want to point at. See section 3 of the header.
 */
export circuit redeem(seat: Uint<8>): Uint<64> {
  const s = disclose(seat);
  assert(s < seatCount, "redeem: no such seat");

  // Terminal tables pay everyone owed. A seat that left BEFORE the start is paid whenever it
  // asks: its stake is its own again, and no later share-out touches it (`leftBeforeStart`).
  // Mid-game eliminations still wait -- the all-eliminated waiver may yet REPLACE their
  // refund, and a refund already withdrawn cannot be replaced.
  const left = seatProgress.lookup(s).finishedAtRound == leftBeforeStart();
  assert(phase == Phase.settled || phase == Phase.aborted || left,
         "redeem: the table is not finished -- nothing may be withdrawn while it is live"
         );

  const amount = seatRedeemable.lookup(s);
  assert(amount > 0, "redeem: this seat has nothing to redeem");

  const who = seatIdentity.lookup(s).addr;
  seatRedeemable.insert(s, 0);
  seatPaid.insert(s, (seatPaid.lookup(s) + amount) as Uint<64>);
  seatReceipt.insert(
    s,
    redeemDigest(seatReceipt.lookup(s), tableId, s, amount, who, seatCard.lookup(s))
    );

  sendUnshielded(nativeToken(), amount as Uint<128>, right<ContractAddress, UserAddress>(who));

  padTransaction();
  return amount;
}

// ===========================================================================================
// abortTable
// ===========================================================================================

/**
 * End a table that cannot finish, and turn the whole pot into per-seat refunds.
 *
 * PAYS NOBODY DIRECTLY. It moves money from `pot` into `seatRedeemable` and leaves the sending
 * to `redeem`, which is the only circuit that pays a player. That keeps one payout path instead
 * of two, keeps the custody invariant a single line, and removes the old version's hazard of
 * sending to a pre-inserted zero address.
 *
 * Permissionless, and legal in exactly three situations:
 *
 *   * `filling` and stalled -- the table did not fill within `tableTimeoutSecs` of the last
 *     join. An EMPTY table is deliberately not abortable: `roundDeadline` is 0 until the first
 *     join, so an empty table would look infinitely stalled, and aborting it on sight is a free
 *     griefing move against a table with no funds to protect.
 *
 *   * `playing`, some seat is waiting on the OPERATOR, and `tableTimeoutSecs` has passed on top
 *     of the round deadline. This is the documented residual of the randomness design: a
 *     seed-knowing operator can selectively withhold resolution when the upcoming dice displease
 *     it. It cannot alter an outcome, only freeze the table, and this circuit is what converts
 *     that freeze into a refund. `!playerOwes(stage)` covers all three roll steps alike -- a
 *     stall at 1, 3 or 5 is the same stall.
 *
 *     THE WAITING-ON-THE-OPERATOR CONDITION IS LOAD-BEARING, not decoration. Without it, a
 *     player who is losing could simply stop playing, let the round deadline and the table grace
 *     both pass, and abort the game into a full refund. With it, a table where every seat's next
 *     move is its own has only one exit -- `eliminate` the stragglers, then `closeRound` -- and
 *     both of those are permissionless and available a whole table-timeout before this circuit
 *     would have been. So the losing player's stall is answered by the remedy that costs them a
 *     penalty, not by the one that gives them their money back.
 *
 *   * `abandoned` -- every seat was eliminated. No further waiting: the deadline that produced
 *     it has already elapsed.
 *
 * THE ALL-ELIMINATED WAIVER LIVES HERE. Decision 1 of docs/simultaneous-rounds.md: when nobody
 * kept playing there is nobody for the penalties to compensate, so they are waived and every
 * seat gets its stake back less the 1% rake -- and the rake IS still paid, because the operator
 * did its work regardless. Applying it needs a single pass over all six seats and a rake
 * payment, which is exactly the shape of this circuit and exactly the wrong shape for
 * `eliminate`, whose job is one seat and which has no headroom to spare for six writes and a
 * send. The cost of putting it here is one extra permissionless transaction on the
 * all-eliminated path, and in exchange `eliminate` stays a small, single-seat, provable circuit.
 *
 * THE OTHER TWO CASES PAY NO RAKE. The table never produced a game: either it never filled, or
 * the operator abandoned it. Raking a table the operator failed to run would pay it for failing.
 *
 * `q` and `rem` are the PER-SEAT rake on `tier`, not on the pot: `q * 100 + rem == tier`,
 * `rem < 100`, so each seat gets `tier - q` and the rake gets `q * seatCount`. Dividing the pot
 * instead would need a division by `seatCount`, which the language does not have. The identity
 * is required unconditionally, even on the two cases that pay no rake -- it is a function of
 * `tier` alone, so it is always satisfiable, and demanding it keeps the argument encoding
 * canonical instead of leaving two ignored fields a caller could stuff with anything.
 *
 * THE FOURTH CASE STARTS THE GAME INSTEAD. A filling table whose early-start clock has run --
 * `startAfterSecs` after the last join -- with at least two active seats does not refund: it
 * STARTS, with whoever is there, exactly as `join` starts a full one. This lives here and not in
 * a circuit of its own because the table sits at the nine-circuit deploy ceiling, and "the
 * filling period is over; what happens to the stakes?" is this circuit's question already. It
 * outranks the never-filled refund whenever two players are present. `now` is needed for the
 * new round deadline, pinned like `join`'s and `closeRound`'s.
 *
 * SEATS THAT LEFT BEFORE THE START are skipped by every share-out: their stake was refunded in
 * full when they left and may already have been withdrawn. A table everyone left before it
 * started closes with no shares and no rake -- there was no game to pay for.
 */
export circuit abortTable(q: Uint<64>, rem: Uint<64>, now: Uint<64>): Uint<64> {
  const t = disclose(now);
  pinTime(t);

  // Early start: the clock runs from the LAST join, so a table still attracting players keeps
  // waiting for a full house, and one that stopped attracting them starts with who came.
  const startClock = (fillOpenedAt + startAfterSecs) as Uint<64>;
  const starting =
          phase == Phase.filling &&
          startAfterSecs > 0 &&
          activeSeats >= 2 &&
          blockTimeGt(startClock);

  const fillingStalled =
          phase == Phase.filling && seatCount > 0 && blockTimeGt(roundDeadline) && !starting;

  const graceExpired = blockTimeGt((roundDeadline + tableTimeoutSecs) as Uint<64>);
  const waiting = awaitingOperatorAt(0) ||
                  awaitingOperatorAt(1) ||
                  awaitingOperatorAt(2) ||
                  awaitingOperatorAt(3) ||
                  awaitingOperatorAt(4) ||
                  awaitingOperatorAt(5);
  const operatorStalled = phase == Phase.playing && waiting && graceExpired;

  const allOut = phase == Phase.abandoned;

  assert(starting || fillingStalled || operatorStalled || allOut,
         "abortTable: the table is neither stalled past its deadline nor abandoned"
         );

  const rake = disclose(q);
  const slack = disclose(rem);
  assert(rakeIsValid(tier, rake, slack),
         "abortTable: the per-seat rake must satisfy q * 100 + rem == tier with rem < 100"
         );

  assertCustody();

  // The waiver: penalties refunded, the rake still paid. On the other two paths nobody has been
  // eliminated for a penalty worth waiving -- or if they have, the table never produced a game,
  // so the whole stake goes back and the rake is not earned.
  // A rake is due only when a game was played and then abandoned by everyone: the operator did
  // its work. Never filled, operator stalled, or abandoned before the start: no rake.
  const raking = allOut && started;
  const share = raking ? (tier - rake) as Uint<64> : tier;

  // One pass over the six slots. A slot takes a share if it is a live seat, or a seat eliminated
  // DURING PLAY (whose refund the waiver replaces). A slot that left before the start already
  // holds -- or has withdrawn -- its full stake and is skipped. When STARTING nothing is shared.
  const e0 = shareEligible(0);
  const e1 = shareEligible(1);
  const e2 = shareEligible(2);
  const e3 = shareEligible(3);
  const e4 = shareEligible(4);
  const e5 = shareEligible(5);
  if (e0 && !starting) {
    seatRedeemable.insert(0, share);
  }
  if (e1 && !starting) {
    seatRedeemable.insert(1, share);
  }
  if (e2 && !starting) {
    seatRedeemable.insert(2, share);
  }
  if (e3 && !starting) {
    seatRedeemable.insert(3, share);
  }
  if (e4 && !starting) {
    seatRedeemable.insert(4, share);
  }
  if (e5 && !starting) {
    seatRedeemable.insert(5, share);
  }
  const shares = ((e0 ? 1 : 0) +
                  (e1 ? 1 : 0) +
                  (e2 ? 1 : 0) +
                  (e3 ? 1 : 0) +
                  (e4 ? 1 : 0) +
                  (e5 ? 1 : 0))
                 as Uint<64>;
  const rakeTotal = (raking ? (rake * shares) : 0) as Uint<64>;

  if (raking) {
    sendUnshielded(
      nativeToken(),
      rakeTotal as Uint<128>,
      right<ContractAddress, UserAddress>(rakeAddress)
      );
  }

  if (starting) {
    // Round 0 opens now for the seats that are here. The pot already holds exactly their
    // stakes: every leaver took its own back at `eliminate`.
    phase = Phase.playing;
    started = true;
    openRound = 0;
    roundDeadline = (t + turnTimeoutSecs) as Uint<64>;
  } else {
    pot = 0;
    finalDigest =
      finalDigestOf(
        roundDigest,
        tableId,
        Phase.aborted as Uint<8>,
        maxSeats(),
        seatCount,
        0,
        rakeTotal,
        share,
        false
        );
    phase = Phase.aborted;
  }

  padTransaction();
  // A start shares nothing out; the refund paths return the per-seat share.
  return starting ? 0 : share;
}

/** Is this slot's next move the operator's -- i.e. is a roll outstanding? */
circuit awaitingOperatorAt(s: Uint<8>): Boolean {
  return s < seatCount && !playerOwes(seatTurn.lookup(s).stage);
}

/** Does this slot take a share in an abort: a seated player, or one eliminated during play? */
circuit shareEligible(s: Uint<8>): Boolean {
  const prog = seatProgress.lookup(s);
  return s < seatCount && (!prog.eliminated || prog.finishedAtRound == noFinish());
}

export { UserAddress, ContractAddress };
