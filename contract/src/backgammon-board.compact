  assert(!over3 || higher3 == 0, "ply: sub-move 3 bears off with a larger die while a checker sits on a higher point");

  // ---- the opponent after the ply: a blot on a point I landed on goes to the bar ----
  const hit1 = opp[1] == 1 && (lt0_24 || lt1_24 || lt2_24 || lt3_24);
  const hit2 = opp[2] == 1 && (lt0_23 || lt1_23 || lt2_23 || lt3_23);
