/**
 * `applyPly`, plus: a die the ply leaves unplayed must be unplayable on the final board.
 */
export pure circuit applyPlyStrict(
                mine: Vector<26, Uint<8>>,
                opp: Vector<26, Uint<8>>,
                a: Uint<8>,
                b: Uint<8>,
                ply: Vector<4, SubMove>,
                count: Uint<8>,
                ): PlyOutcome {
  assert(a >= 1 && a <= 6 && b >= 1 && b <= 6, "ply: the dice are not both 1..6");
  assert(count <= 4, "ply: at most four checkers move in one ply");
  const dbl = a == b;
  assert(dbl || count <= 2, "ply: without doubles a ply plays at most two dice");
  const act0 = count >= 1;
  const act1 = count >= 2;
  const act2 = count >= 3;
  const act3 = count >= 4;
  const f0 = ply[0].point;
  const d0 = ply[0].die;
  const f1 = ply[1].point;
  const d1 = ply[1].die;
  const f2 = ply[2].point;
  const d2 = ply[2].die;
  const f3 = ply[3].point;
  const d3 = ply[3].die;

  // ---- the argument encoding: played slots first, unused slots exactly {0, 0} ----
  assert(act0 || (f0 == 0 && d0 == 0), "ply: sub-move 0 is unused and must be {point: 0, die: 0}");
  assert(!act0 || (f0 >= 1 && f0 <= 25), "ply: sub-move 0 starts off the board");
  assert(act1 || (f1 == 0 && d1 == 0), "ply: sub-move 1 is unused and must be {point: 0, die: 0}");
  assert(!act1 || (f1 >= 1 && f1 <= 25), "ply: sub-move 1 starts off the board");
  assert(act2 || (f2 == 0 && d2 == 0), "ply: sub-move 2 is unused and must be {point: 0, die: 0}");
  assert(!act2 || (f2 >= 1 && f2 <= 25), "ply: sub-move 2 starts off the board");
  assert(act3 || (f3 == 0 && d3 == 0), "ply: sub-move 3 is unused and must be {point: 0, die: 0}");
  assert(!act3 || (f3 >= 1 && f3 <= 25), "ply: sub-move 3 starts off the board");

  // ---- each die as rolled: doubles give four of one value, otherwise each die once ----
  assert(!act0 || d0 == a || d0 == b, "ply: sub-move 0 uses a die that was not rolled");
