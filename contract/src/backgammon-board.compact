  const outside3 = m3_7 + m3_8 + m3_9 + m3_10 + m3_11 + m3_12 + m3_13 + m3_14 + m3_15 + m3_16 + m3_17 + m3_18 + m3_19 + m3_20 + m3_21 + m3_22 + m3_23 + m3_24 + m3_25;
  assert(!off3 || outside3 == 0, "ply: sub-move 3 bears off while a checker is outside the home board");
  const over3 = off3 && tt3 < 6;
