//
// The Backgammon table's dice on ledger 9: BOTH PLAYERS' secrets, and nobody else's.
//
// `include`d by backgammon.compact AFTER dice-core.compact, whose byte ladder (`dieFromBytes`,
// the `Pick` accumulator) it reuses unchanged -- so this file carries no pragma and no import of
// its own. Editing it changes the Backgammon table's verifier keys; it does not touch Yacht's,
// which never include it.
//
// ---------------------------------------------------------------------------------------------
// Who knows a roll, and when
// ---------------------------------------------------------------------------------------------
//
// Each seat commits to a secret `sk` when it joins (only `H(sk, tableId)` is public). Every value
// below is FORCED from it -- computed and proven in the circuit, never chosen:
//
//     o_s    = bgOpeningSecret(sk_s)      the seat's share of the opening, revealed after the start
//     v_s(t) = bgRollSecret(sk_s, t)      the mover's secret for ply t, revealed by its move at t
//
//     opening   = ladder(H(tableId, o_0, o_1))                    a die per seat, never a double
//     ply t     = ladder(H(tableId, v_mover(t), e, t))            e = the secret the previous move
//                                                                     revealed (the opponent's)
//
// So a ply's roll needs a secret from EACH player:
//
//   * nobody but the mover can compute it before the mover's move reveals `v_mover(t)` -- not the
//     opponent, not the operator, not the two together;
//   * the mover itself can compute it only once the opponent's move has revealed `e`, which is the
//     moment it becomes the mover's turn -- never while it is choosing the move before;
//   * nobody can choose it: both inputs are fixed by keys committed before the game began, and the
//     board is deliberately not in any roll (it would let a player pick among legal moves to steer
//     the next one).
//
// The operator has no input at all, so it has nothing to hide from and nothing to be trusted
// with: it cannot see, choose or foresee a roll, alone or with a player. This replaced the blind
// VRF (2026-09-29): with the opponent's secret in every roll the table key added nothing, and
// "the operator must not play at its own tables" is no longer a condition of fairness.
//
// THE OPENING'S SHARES ARE REVEALED AFTER THE START, not at join. A share public at join would let
// the second joiner try keys until it liked the opening. Revealed afterwards, the later revealer
// sees the opening first -- but its share is forced, so all it can do is not reveal, which loses
// it the game on the clock.

/** The two dice of a ply. For the opening, `a` is seat 0's die and `b` seat 1's. */
export struct BgDice {
  a: Uint<8>,
  b: Uint<8>,
}

/** A seat's forced entropy: `H(sk, tableId, index)`. Proven, never chosen. */
export struct BgEntropyContext {
  domain: Bytes<32>,
  sk: Bytes<32>,
  tableId: Bytes<32>,
  turn: Uint<16>,
}

export pure circuit bgForcedEntropy(sk: Bytes<32>, tableId: Bytes<32>, turn: Uint<16>): Bytes<32> {
  return persistentHash<BgEntropyContext>(
           BgEntropyContext { domain: pad(32, "dust-dice:bg:v3:entropy"),
                              sk: sk,
                              tableId: tableId,
                              turn: turn, }
           );
}

/** A seat's share of the opening, revealed after the start. Index 0 -- no ply uses it. */
export pure circuit bgOpeningSecret(sk: Bytes<32>, tableId: Bytes<32>): Bytes<32> {
  return bgForcedEntropy(sk, tableId, 0);
}

/**
 * The mover's secret for ply `t`: index t+1, so it never collides with the opening's. Its move at
 * ply t reveals it, and the other seat's next roll hashes it.
 */
export pure circuit bgRollSecret(sk: Bytes<32>, tableId: Bytes<32>, t: Uint<16>): Bytes<32> {
  return bgForcedEntropy(sk, tableId, (t + 1) as Uint<16>);
}

/** Everything that identifies one Backgammon roll. Fixed-width fields, hashed whole. */
export struct BgRollContext {
  domain: Bytes<32>,
  tableId: Bytes<32>,
  mine: Bytes<32>,
  other: Bytes<32>,
  turn: Uint<16>,
  stream: Uint<8>,
}

/**
 * The 32 bytes behind one roll: two secrets, one from each player, the ply and the stream (1 for
 * the opening, 0 for a ply).
 */
export pure circuit bgRollBytes(
                      tableId: Bytes<32>,
                      mine: Bytes<32>,
                      other: Bytes<32>,
                      turn: Uint<16>,
                      stream: Uint<8>,
                      ): Vector<32, Uint<8>> {
  return persistentHash<BgRollContext>(
           BgRollContext { domain: pad(32, "dust-dice:bg:v3:roll"),
                           tableId: tableId,
                           mine: mine,
                           other: other,
                           turn: turn,
                           stream: stream, }
           )
         as Vector<32, Uint<8>>;
}

/**
 * FIVE-face candidate for the opening's second die: accept b < 250, five buckets of 50.
 * The same shape as dice-core's six-face `byteCandidate`.
 */
pure circuit fiveCandidate(acc: Pick, b: Uint<8>): Pick {
  const v = (1 +
             ((b >= 50) as Uint<8>) +
             ((b >= 100) as Uint<8>) +
             ((b >= 150) as Uint<8>) +
             ((b >= 200) as Uint<8>))
            as Uint<8>;
  return acc.found ? acc : (b < 250 ? Pick { found: true, die: v } : acc);
}

/** 1..5 from 4 candidate bytes. Exhaustion probability (6/256)^4 = 3.0e-7 (falls back to 1). */
pure circuit fiveFromBytes(cands: Vector<4, Uint<8>>): Uint<8> {
  const p = fold((acc: Pick, b: Uint<8>) => fiveCandidate(acc, b), noPick(), cands);
  return p.die;
}

/**
 * Two dice from a roll's 32 bytes -- or, when `opening`, the two opening dice.
 *
 * The opening's second die is `e + (e >= a)` with `e` uniform on 1..5 -- uniform on the five
 * faces that are NOT `a` -- so the pair is never a double and needs no re-throw. Every ordered
 * pair of distinct faces has probability exactly 1/30.
 */
export pure circuit bgDiceFromBytes(v: Vector<32, Uint<8>>, opening: Boolean): BgDice {
  const a = dieFromBytes([v[0], v[1], v[2], v[3]]);
  const six = dieFromBytes([v[4], v[5], v[6], v[7]]);
  const five = fiveFromBytes([v[4], v[5], v[6], v[7]]);
  const other2 = (five + ((five >= a) as Uint<8>)) as Uint<8>;
  return BgDice { a: a, b: opening ? other2 : six };
}

/** The opening pair from both seats' shares: `a` is seat 0's die, `b` seat 1's. */
export pure circuit bgOpeningDice(tableId: Bytes<32>, o0: Bytes<32>, o1: Bytes<32>): BgDice {
  return bgDiceFromBytes(bgRollBytes(tableId, o0, o1, 0, 1), true);
}

/** Ply `t`'s dice from the mover's secret for it and the previous move's revealed secret. */
export pure circuit bgPlyDice(
                      tableId: Bytes<32>,
                      mine: Bytes<32>,
                      other: Bytes<32>,
                      t: Uint<16>,
                      ): BgDice {
  return bgDiceFromBytes(bgRollBytes(tableId, mine, other, t, 0), false);
}
