//
// The entropy scheme and the reroll merge -- the dice half of a turn, minus the dice ladder
// itself, which is dice-core.compact's.
//
// `include`d verbatim by table.compact (and by the measurement probes), so this file carries
// NO pragma and NO import of its own -- the including file supplies both, and must also
// `include "dice-core"` FIRST (this file calls `deriveDice` and `rollContext`). Same
// convention as dice-core.compact and scoring-core.compact. Editing this file changes the
// verifier keys of every contract that includes it.
//
// ---------------------------------------------------------------------------------------
// WHAT THE INTERACTIVE-HOLD REDESIGN REMOVED FROM THIS FILE
// ---------------------------------------------------------------------------------------
//
// Everything to do with PRE-DECLARED HOLD POLICIES. The player used to choose one of six
// deterministic rules (Stand, RerollAll, KeepModal, KeepFace, ChaseStraight, KeepPairsPlus)
// before any dice existed, and the circuit computed a mask from it -- including the
// witness-the-answer `isCanonicalModal` machinery, which existed only because a 6-way argmax
// over face counts could not be computed in-circuit without tripping docs/bugs-found.md #1.
//
// The player now sees each roll and names the dice to keep, so the mask arrives as five
// explicit bits and there is nothing to compute. Deleted: the policy codes, `isValidPolicy`,
// `pFaceCount`, `pFlag`, `modalOkAt`, `isCanonicalModal`, `DiePredicates`, `predicates0..4`,
// `holdBit`, `holdMaskOf`, `resolveDice`, `resolveDiceChecked`, `firstRollChecked` and the
// `modalFaceHint` witness they were all in service of.
//
// api/src/policies.ts is no longer contract-canonical for anything. It is left in place
// because the site still imports its type, and it now describes a game nobody plays.
//
// WHAT SURVIVED, and why each piece is still load-bearing:
//
//   forcedEntropy         a player still cannot choose their per-round entropy
//   entropyKeyCommitment  a seat's join-time authorisation key
//   seedCommitmentOf      the operator's commit-reveal
//   mixEntropy            folds the FROZEN round digest into a seat's entropy
//   firstRoll             roll 1, with no mask to latch
//   rerollUnderMask       rolls 2 and 3, under a mask the PLAYER supplied
//
// ---------------------------------------------------------------------------------------
// The reroll merge changed shape, and the change is visible on chain
// ---------------------------------------------------------------------------------------
//
// The old `mergeHeld` was POSITIONAL: die `i` of a reroll came from byte positions `4i..4i+3`
// of that roll's hash whether or not positions before it were rerolled. The new `mergeStream`
// is a STREAM: the fresh roll is consumed LEFT TO RIGHT over the rerolled positions only, so
// if a player holds positions 0 and 3, the two dice they get back are `fresh[0]` and
// `fresh[1]`, not `fresh[1]` and `fresh[2]`.
//
// This is the model api/src/policies.ts always used and the circuit did not, and the
// divergence was documented in src/policy-mirror.ts as a deliberate one. Now they agree.
// It costs ten conditional selects -- position `i` can only draw from `fresh[0..i]`, so the
// mux widths are 1, 2, 3, 4 and 5 -- and the cost was measured before being accepted, because
// `resolveRoll2` and `resolveRoll3` sit at the SRS ceiling with no headroom at all.

// ---------------------------------------------------------------------------------------
// Entropy, commitments, mixing
// ---------------------------------------------------------------------------------------

/**
 * The player's per-round entropy, forced: `entropy_s(r) = H(sk_s, tableId, r)`.
 *
 * A player cannot pick this at turn time -- it is a function of the secret they committed to at
 * `join` and the round number. That closes the operator-player collusion grind for ENTROPY:
 * knowing the seed buys nothing if you cannot vary your own input.
 *
 * It is also what makes every seat's dice stream distinct, which matters more under
 * simultaneous rounds than it did under the cursor. `RollContext` has no seat field -- the
 * separation comes entirely from `playerEntropy`, which is a hash of `sk_s`. Two seats can
 * only collide by sharing a secret, and `join` refuses a second seat for a `C_s` already
 * registered.
 */
export pure circuit forcedEntropy(sk: Bytes<32>, tableId: Bytes<32>, round: Uint<8>): Bytes<32> {
  return persistentHash<EntropyContext>(
           EntropyContext { domain: pad(32, "yahtzee:v1:entropy"),
                            sk: sk,
                            tableId: tableId,
                            round: round, }
           );
}

export struct EntropyContext {
  domain: Bytes<32>,
  sk: Bytes<32>,
  tableId: Bytes<32>,
  round: Uint<8>,
}

/**
 * The join-time commitment to a seat's entropy secret: `C_s = H(tableId, sk_s)`, domain-tagged.
 *
 * `tableId` IS PART OF THE COMMITMENT, and the reason is linkability rather than dice fairness:
 * without it, a client that reuses one `sk_s` across two tables publishes the same `C_s` at both,
 * and an observer can join the two seats up. `forcedEntropy` already re-binds `tableId`, so the
 * dice were never at risk -- this closes the identifier, not the randomness.
 */
export pure circuit entropyKeyCommitment(tableId: Bytes<32>, sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "yahtzee:v1:entkey"), tableId, sk]);
}

/**
 * The operator's commitment to its roll seed, made before any player exists.
 *
 * `tableId` IS PART OF THE COMMITMENT, and here it is a real security property rather than a
 * tidiness one. `settle` reveals the seed by design. If the same seed were ever reused for two
 * tables, both would carry the SAME commitment, and the first table's settlement would hand any
 * observer the second, still-live table's entire future randomness.
 */
export pure circuit seedCommitmentOf(tableId: Bytes<32>, seed: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "yahtzee:v1:seed"), tableId, seed]);
}

/**
 * The player entropy that actually feeds the roll hash: the forced entropy folded together
 * with the round digest.
 *
 *     mixed  = H("mix", entropy_s(r), roundDigest_r)
 *     roll   = H("roll", tableId, seed, mixed, r, rollIndex)
 *
 * Every input docs/table-contract.md names is present and each occupies a fixed-width field of
 * a single hash, so nothing can be slid between fields. The indirection exists because
 * `RollContext` is already deployed in three measured contracts and mirrored byte-for-byte by
 * src/dice-mirror.ts; adding a field would change the dice of every existing artifact.
 *
 * `roundDigest_r` IS FROZEN FOR THE WHOLE ROUND. Under simultaneous rounds that is a security
 * requirement rather than a convenience: a digest that advanced per resolve would let the
 * operator choose everybody's dice by choosing the order it resolved six seats in. See section
 * 2 of table.compact's header.
 */
export pure circuit mixEntropy(entropy: Bytes<32>, roundDigest: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "yahtzee:v1:mix"), entropy, roundDigest]);
}

// ---------------------------------------------------------------------------------------
// The reroll merge -- left-to-right over rerolled positions
// ---------------------------------------------------------------------------------------

/** `Boolean` as a tight 0/1 integer. `Uint<1>`, never `Uint<0..1>` -- docs/bugs-found.md #10. */
pure circuit pFlag(x: Boolean): Uint<1> {
  return x as Uint<1>;
}

/**
 * How many of the positions before `i` are being rerolled -- i.e. which die of the fresh roll
 * position `i` draws.
 *
 * Written as five separate one-line circuits rather than a loop with a runtime bound because a
 * `Vector` index must be a compile-time constant, and written as a flat sum rather than a
 * running accumulator because a chain of conditionals over the same operands is the shape
 * docs/bugs-found.md #1 punishes.
 */
pure circuit rank1(h: Vector<5, Boolean>): Uint<8> {
  return (1 - pFlag(h[0])) as Uint<8>;
}

pure circuit rank2(h: Vector<5, Boolean>): Uint<8> {
  return (2 - pFlag(h[0]) - pFlag(h[1])) as Uint<8>;
}

pure circuit rank3(h: Vector<5, Boolean>): Uint<8> {
  return (3 - pFlag(h[0]) - pFlag(h[1]) - pFlag(h[2])) as Uint<8>;
}

pure circuit rank4(h: Vector<5, Boolean>): Uint<8> {
  return (4 - pFlag(h[0]) - pFlag(h[1]) - pFlag(h[2]) - pFlag(h[3])) as Uint<8>;
}

/**
 * The freshly rolled die that lands at position `i`, given how many earlier positions were
 * rerolled.
 *
 * Position `i` can only ever draw from `fresh[0..i]` -- at most `i` positions precede it -- so
 * the mux widths are 1, 2, 3, 4 and 5 rather than 5, 5, 5, 5, 5. Ten selects in total. Each
 * candidate is a leaf of the fresh roll, so no merged die is ever re-read and
 * docs/bugs-found.md #1 does not bite.
 */
pure circuit pick2(f: Vector<5, Uint<8>>, r: Uint<8>): Uint<8> {
  return r == 0 ? f[0] : f[1];
}

pure circuit pick3(f: Vector<5, Uint<8>>, r: Uint<8>): Uint<8> {
  return r == 0 ? f[0] : (r == 1 ? f[1] : f[2]);
}

pure circuit pick4(f: Vector<5, Uint<8>>, r: Uint<8>): Uint<8> {
  return r == 0 ? f[0] : (r == 1 ? f[1] : (r == 2 ? f[2] : f[3]));
}

pure circuit pick5(f: Vector<5, Uint<8>>, r: Uint<8>): Uint<8> {
  return r == 0 ? f[0] : (r == 1 ? f[1] : (r == 2 ? f[2] : (r == 3 ? f[3] : f[4])));
}

/**
 * Keep the held dice; fill the rerolled positions from the fresh roll, LEFT TO RIGHT.
 *
 * Mirrored exactly by `mergeStreamTs` in src/policy-mirror.ts. The settlement verifier replays
 * every roll of every game through that mirror, so a divergence here is a game nobody can check.
 *
 * Position 0 is a special case only in that its rank is always 0: if it is rerolled it takes
 * `fresh[0]`, because no position precedes it.
 */
export pure circuit mergeStream(
                      hold: Vector<5, Boolean>,
                      kept: Vector<5, Uint<8>>,
                      fresh: Vector<5, Uint<8>>,
                      ): Vector<5, Uint<8>> {
  return [hold[0] ? kept[0] : fresh[0],
          hold[1] ? kept[1] : pick2(fresh, rank1(hold)),
          hold[2] ? kept[2] : pick3(fresh, rank2(hold)),
          hold[3] ? kept[3] : pick4(fresh, rank3(hold)),
          hold[4] ? kept[4] : pick5(fresh, rank4(hold)),];
}

// ---------------------------------------------------------------------------------------
// The two roll steps
// ---------------------------------------------------------------------------------------

/**
 * Roll 1: five fresh dice, no mask, nothing held.
 *
 * There is nothing to latch any more. Under pre-declared policies this step also computed the
 * hold mask from roll 1 and wrote it to the ledger, because the mask was a function of the dice;
 * an interactive hold arrives as an argument one transaction later, so roll 1 is now purely a
 * derivation.
 */
export pure circuit firstRoll(
                      tableId: Bytes<32>,
                      seed: Bytes<32>,
                      mixed: Bytes<32>,
                      round: Uint<8>,
                      ): Vector<5, Uint<8>> {
  return deriveDice(rollContext(tableId, seed, mixed, round, 0));
}

/**
 * Rolls 2 and 3: reroll exactly the positions the player did not hold.
 *
 * `hold` comes off the ledger, where the player's own `playerMove` transaction put it, so the
 * operator has no say in it whatever. `rollIndex` separates the two rerolls' hashes.
 */
export pure circuit rerollUnderMask(
                      tableId: Bytes<32>,
                      seed: Bytes<32>,
                      mixed: Bytes<32>,
                      round: Uint<8>,
                      rollIndex: Uint<8>,
                      hold: Vector<5, Boolean>,
                      kept: Vector<5, Uint<8>>,
                      ): Vector<5, Uint<8>> {
  return mergeStream(hold, kept, deriveDice(rollContext(tableId, seed, mixed, round, rollIndex)));
}
