{
  "name": "dust-dice-contract",
  "version": "0.4.0",
  "private": true,
  "description": "Dust Dice — a Yahtzee-style dice game on Midnight: the Compact contracts, their TypeScript mirrors and witnesses, the independent game verifier, and the protocol documentation. Local devnet / testnet only.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "contract",
    "api",
    "verifier"
  ],
  "overrides": {
    "@midnight-ntwrk/wallet-sdk-utilities": "1.2.1"
  },
  "scripts": {
    "compact": "npm run compact -w contract",
    "build": "npm run build -w contract && npm run build -w api",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run verify -w verifier --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
