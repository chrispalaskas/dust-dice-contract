# deps / builds
node_modules/
dist/
.next/
*.tsbuildinfo

# generated Compact output (rebuilt from source; stale copies serve old interfaces)
contract/src/managed/
contract/build/
probes/*/src/managed/

# probe run state (contract addresses, throwaway seeds, timings — regenerated per run)
probes/*/.run/

# local chain / wallet state (local-dev-only, regenerated at will)
.devnet-volumes/
.midnight-wallet-state/
midnight-level-db/
*.wallet-state.json

# misc
.env.local
.DS_Store
coverage/

# local plugin/tool state
.midnight-expert/

# cli run state (contract addresses, throwaway seeds, timings — regenerated per run)
cli/.run/

# Next 16 writes these into the workspace unless agentRules is disabled
ui/AGENTS.md
ui/CLAUDE.md

# Operator seeds and the table registry. LOAD-BEARING: operator-state.json holds every open
# table's roll seed — committing it would publish the secret the commit-reveal scheme depends
# on, letting anyone precompute that table's dice. See service/README.md.
service/.state/
service/.state-smoke-*/

# local `npm pack` output for the ledger-8 branch — consumed by ../dust-dice as file: tarballs
packs/
